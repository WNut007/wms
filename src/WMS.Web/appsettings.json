{
  "ConnectionStrings": {
    "MasterDb": "Server=localhost;Database=WMS_Master;Trusted_Connection=true;TrustServerCertificate=true",
    "TenantTemplate": "Server=localhost;Database={0};Trusted_Connection=true;TrustServerCertificate=true"
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/storage"
    },
    "MaxFileSizeMB": 50,
    "AllowedExtensions": [
      ".pdf", ".docx", ".doc", ".xlsx", ".xls", ".csv", ".txt",
      ".png", ".jpg", ".jpeg", ".webp", ".gif",
      ".webm", ".mp4"
    ]
  },
  "PackVideoRetention": {
    "RetentionDays": 10,
    "CronSchedule": "0 3 * * *",
    "JobId": "pack-video-retention-cleanup"
  },
  "InitialSuperAdmin": {
    "_comment": "Phase 27 — bootstrap seed for the first SuperAdmin. Idempotent on Email; InitialPassword only applied when no SuperAdmin exists for this Email. Production should rotate this password via /SuperAdmin/Account/ChangePassword on first login (MustChangePassword=true is set on seed).",
    "Email": "superadmin@wms.local",
    "FullName": "Platform Administrator",
    "InitialPassword": "ChangeMe!2026"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
