@model IReadOnlyList<WMS.Common.Auth.UserPermission>

@{
    ViewData["Title"] = "Permissions";
    var grouped = Model.GroupBy(p => p.FunctionCode).OrderBy(g => g.Key);
}

<div class="row justify-content-center mt-4">
    <div class="col-md-9">
        <h3>Your permissions</h3>
        <p class="text-muted small">
            @Model.Count permission rows across @grouped.Count() functions.
            Resolved via IPermissionService (15-minute sliding cache).
        </p>

        @if (Model.Count == 0)
        {
            <div class="alert alert-warning">
                You have no granted permissions in this tenant.
            </div>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Function</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in grouped)
                    {
                        <tr>
                            <td><code>@group.Key</code></td>
                            <td>
                                @foreach (var p in group.OrderBy(x => x.Action))
                                {
                                    <span class="badge bg-secondary me-1">@p.Action</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back home</a>
    </div>
</div>
