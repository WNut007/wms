@using System.Security.Claims
@using WMS.Common.Auth

@{
    ViewData["Title"] = "Home";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="page-header d-print-none">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Signed in</h2>
                <div class="text-secondary">Your active session details.</div>
            </div>
        </div>
    </div>

    <div class="row row-cards mt-2">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Session</h3>
                </div>
                <div class="card-body">
                    <div class="datagrid">
                        <div class="datagrid-item">
                            <div class="datagrid-title">Name</div>
                            <div class="datagrid-content">@User.Identity.Name</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Email</div>
                            <div class="datagrid-content">
                                @User.FindFirst(ClaimTypes.Email)?.Value
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Tenant</div>
                            <div class="datagrid-content">
                                <code>@User.FindFirst(WmsClaimTypes.TenantId)?.Value</code>
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Warehouse</div>
                            <div class="datagrid-content">
                                <code>@User.FindFirst(WmsClaimTypes.WarehouseId)?.Value</code>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="empty">
        <p class="empty-title">WMS</p>
        <p class="empty-subtitle text-secondary">Warehouse Management System</p>
        <div class="empty-action">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">
                Sign in
            </a>
        </div>
    </div>
}
