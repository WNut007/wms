@using System.Security.Claims
@using WMS.Common.Auth

@{
    ViewData["Title"] = "Home";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="row justify-content-center mt-3">
        <div class="col-md-8">
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">Signed in</h4>
                <dl class="row mb-0">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@User.Identity.Name</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@User.FindFirst(ClaimTypes.Email)?.Value</dd>

                    <dt class="col-sm-3">Tenant</dt>
                    <dd class="col-sm-9"><code>@User.FindFirst(WmsClaimTypes.TenantId)?.Value</code></dd>

                    <dt class="col-sm-3">Warehouse</dt>
                    <dd class="col-sm-9"><code>@User.FindFirst(WmsClaimTypes.WarehouseId)?.Value</code></dd>
                </dl>
                <hr />
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-secondary btn-sm">
                    Sign out
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center mt-5">
        <h1 class="display-4">WMS</h1>
        <p class="lead">Warehouse Management System</p>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Sign in</a>
    </div>
}
