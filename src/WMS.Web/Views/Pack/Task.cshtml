@using WMS.DAL.Common
@using WMS.DAL.Repositories.Master
@model WMS.DAL.Repositories.Outbound.PackTaskDetail
@{
    ViewData["Title"] = $"Pack {Model.Header.PackNumber}";
    var soNumber = ViewBag.SoNumber as string ?? "—";
    var productMeta = ViewBag.ProductMeta as IReadOnlyDictionary<Guid, ProductLineMeta>
                      ?? new Dictionary<Guid, ProductLineMeta>();
    var boxTypes = ViewBag.BoxTypes as IReadOnlyList<LookupItem>
                   ?? new List<LookupItem>();

    var okMsg = ViewBag.PackMessage as string;
    var errMsg = ViewBag.PackError as string;

    // Build initial Alpine state — defaults PackedQuantity = PickedQuantity
    // (the "everything goes in the carton" zero-click submit), LineStatus
    // = 'Packed'. Operator changes only on variance.
    var initialJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Lines.Select(l =>
        {
            var meta = productMeta.GetValueOrDefault(l.ProductId);
            return new
            {
                lineId          = l.Id,
                lineNumber      = l.LineNumber,
                productCode     = meta?.Code ?? l.ProductId.ToString("N").Substring(0, 8),
                productName     = meta?.Name ?? "(product not found)",
                trackingMethod  = meta?.TrackingMethod ?? "None",
                pickedQuantity  = l.PickedQuantity,
                packedQuantity  = l.PickedQuantity,
                lineStatus      = "Packed",
                shortPackReason = "",
                notes           = "",
            };
        }));
}

<style>
    .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    .pkt-page-pad { padding: 12px 14px 110px; }   /* 110px bottom for sticky bar + cancel */

    .pkt-banner {
        padding: 8px 12px; border-radius: 8px;
        font-size: 12px; margin-bottom: 10px;
        display: flex; align-items: center; gap: 6px;
    }
    .pkt-banner-ok  { background: #E1F5EE; color: #0F6E56; }
    .pkt-banner-err { background: #FCEBEB; color: #A32D2D; }

    .pkt-crumb {
        display: flex; align-items: center; gap: 6px;
        font-size: 9px; color: #6b7280; margin-bottom: 8px;
    }
    .pkt-back-btn {
        width: 22px; height: 22px; border: 0.5px solid #e5e7eb;
        background: #f3f4f6; border-radius: 6px;
        display: inline-flex; align-items: center; justify-content: center;
        text-decoration: none; color: #6b7280;
    }
    .pkt-current {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-weight: 500; color: #534AB7;
    }

    .pkt-context-bar {
        background: #f9fafb; padding: 8px 12px;
        border-radius: 8px; font-size: 11px; color: #6b7280;
        margin-bottom: 12px;
    }

    .pkt-card {
        background: #ffffff; border: 0.5px solid #e5e7eb;
        border-left: 3px solid #534AB7;
        border-radius: 11px; padding: 12px 14px; margin-bottom: 10px;
    }
    .pkt-line-no {
        font-size: 9px; color: #9ca3af; text-transform: uppercase;
    }
    .pkt-product-code {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 12px; font-weight: 500; color: #1f2937;
        margin-top: 2px;
    }
    .pkt-product-name {
        font-size: 10px; color: #6b7280; margin-top: 1px;
    }
    .pkt-stats-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
        margin-top: 10px;
    }
    .pkt-stat-label {
        font-size: 9px; color: #6b7280; text-transform: uppercase;
    }
    .pkt-stat-value {
        font-size: 22px; font-weight: 500; color: #6b7280;
        font-variant-numeric: tabular-nums;
    }

    .pkt-input {
        width: 100%; height: 40px;
        padding: 4px 8px; font-size: 22px; font-weight: 500;
        border: 0.5px solid #e5e7eb; border-radius: 7px;
        color: #534AB7; background: #ffffff;
        font-variant-numeric: tabular-nums;
    }
    .pkt-input:disabled {
        color: #9ca3af; background: #f3f4f6;
    }
    .pkt-input-text {
        width: 100%; height: 36px;
        padding: 4px 8px; font-size: 12px;
        border: 0.5px solid #e5e7eb; border-radius: 7px;
        background: #ffffff;
    }
    .pkt-textarea {
        width: 100%; min-height: 60px;
        padding: 6px 8px; font-size: 12px;
        border: 0.5px solid #e5e7eb; border-radius: 7px;
        background: #ffffff; resize: vertical;
    }
    .pkt-select {
        width: 100%; height: 36px;
        padding: 4px 8px; font-size: 12px;
        border: 0.5px solid #e5e7eb; border-radius: 7px;
        background: #ffffff;
    }

    .pkt-quick-row {
        display: flex; gap: 6px; margin-top: 6px;
    }
    .pkt-quick-btn {
        flex: 1; height: 32px;
        background: #ffffff; border: 0.5px solid #e5e7eb;
        border-radius: 7px;
        font-size: 11px; font-weight: 500; color: #1f2937;
        cursor: pointer;
    }
    .pkt-quick-btn:active { background: #f3f4f6; }
    .pkt-quick-btn:disabled {
        background: #f9fafb; color: #d1d5db; cursor: not-allowed;
    }

    .pkt-variance {
        margin-top: 6px; font-size: 10px;
        display: flex; align-items: center; gap: 4px;
    }
    .pkt-variance.is-match { color: #0F6E56; }
    .pkt-variance.is-under { color: #854F0B; }
    .pkt-variance.is-skip  { color: #A32D2D; }

    .pkt-collapsible {
        margin-top: 10px; padding-top: 10px;
        border-top: 0.5px dashed #e5e7eb;
    }
    .pkt-field-label {
        font-size: 10px; color: #6b7280; margin-bottom: 4px;
    }
    .pkt-field { margin-bottom: 8px; }
    .pkt-field-required { color: #A32D2D; }

    .pkt-serial-banner {
        margin-top: 10px; padding: 8px 10px;
        background: #FAEEDA; color: #854F0B;
        border-radius: 6px; font-size: 10px;
    }

    .pkt-carton-card {
        background: #ffffff; border: 0.5px solid #e5e7eb;
        border-left: 3px solid #1D9E75;
        border-radius: 11px; padding: 12px 14px; margin-top: 16px;
    }
    .pkt-carton-title {
        font-size: 11px; font-weight: 500; color: #0F6E56;
        text-transform: uppercase;
        display: flex; align-items: center; gap: 6px;
        margin-bottom: 10px;
    }

    .pkt-sticky {
        position: fixed; left: 0; right: 0; bottom: 0;
        background: #ffffff; border-top: 0.5px solid #e5e7eb;
        padding: 10px 14px;
        box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.04);
    }
    .pkt-submit {
        width: 100%; height: 46px;
        background: #534AB7; color: #ffffff;
        border: none; border-radius: 8px;
        font-size: 14px; font-weight: 500; cursor: pointer;
    }
    .pkt-submit:disabled {
        background: #d1d5db; color: #9ca3af; cursor: not-allowed;
    }
    .pkt-cancel {
        width: 100%; height: 36px; margin-top: 6px;
        background: #ffffff; color: #6b7280;
        border: 0.5px solid #e5e7eb; border-radius: 7px;
        font-size: 12px; cursor: pointer;
    }
</style>

<div class="pkt-page-pad" x-data="packTask({ initialLines: @Html.Raw(initialJson) })">
    @if (!string.IsNullOrEmpty(okMsg))
    {
        <div class="pkt-banner pkt-banner-ok">
            <i class="ti ti-check"></i> @okMsg
        </div>
    }
    @if (!string.IsNullOrEmpty(errMsg))
    {
        <div class="pkt-banner pkt-banner-err">
            <i class="ti ti-alert-circle"></i> @errMsg
        </div>
    }

    <div class="pkt-crumb">
        <a href="/pack" class="pkt-back-btn"><i class="ti ti-arrow-left"></i></a>
        <span>Pack</span>
        <i class="ti ti-chevron-right"></i>
        <span class="pkt-current">@Model.Header.PackNumber</span>
    </div>

    <div class="pkt-context-bar">
        <strong>SO @soNumber</strong>
        · @Model.Lines.Count line@(Model.Lines.Count == 1 ? "" : "s")
        · @Model.Lines.Sum(l => l.PickedQuantity).ToString("N2") picked
    </div>

    <form id="pack-form"
          asp-controller="Pack" asp-action="Submit"
          asp-route-taskId="@Model.Header.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Header.Id" />

        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            var l = Model.Lines[i];
            var meta = productMeta.GetValueOrDefault(l.ProductId);
            var isSerial = meta?.TrackingMethod == "LotAndSerial";
            <div class="pkt-card">
                <div class="pkt-line-no">Line @l.LineNumber</div>
                <div class="pkt-product-code">@(meta?.Code ?? l.ProductId.ToString("N").Substring(0, 8))</div>
                <div class="pkt-product-name">@(meta?.Name ?? "(product not found)")</div>

                @if (isSerial)
                {
                    <div class="pkt-serial-banner">
                        <i class="ti ti-list-numbers"></i>
                        <strong>Serial-tracked product.</strong> Mobile pack with serial
                        validation lands in Phase 19.5 (TD-043). Use desktop Pack Detail
                        to record serials for this carton.
                    </div>
                }

                <input type="hidden" name="Lines[@i].LineId" value="@l.Id" />

                <div class="pkt-stats-grid">
                    <div>
                        <div class="pkt-stat-label">Picked</div>
                        <div class="pkt-stat-value">@l.PickedQuantity.ToString("N2")</div>
                    </div>
                    <div>
                        <div class="pkt-stat-label">Packed</div>
                        <input type="number" step="0.0001" min="0"
                               class="pkt-input"
                               inputmode="decimal"
                               name="Lines[@i].PackedQuantity"
                               x-model.number="lines[@i].packedQuantity"
                               :disabled="lines[@i].trackingMethod === 'LotAndSerial' || lines[@i].lineStatus === 'Skipped'" />
                    </div>
                </div>

                <div class="pkt-quick-row" x-show="lines[@i].trackingMethod !== 'LotAndSerial'">
                    <button type="button" class="pkt-quick-btn"
                            :disabled="lines[@i].lineStatus === 'Skipped'"
                            @@click="adjust(@i, -10)">−10</button>
                    <button type="button" class="pkt-quick-btn"
                            :disabled="lines[@i].lineStatus === 'Skipped'"
                            @@click="adjust(@i, -1)">−1</button>
                    <button type="button" class="pkt-quick-btn"
                            :disabled="lines[@i].lineStatus === 'Skipped'"
                            @@click="adjust(@i, 1)">+1</button>
                    <button type="button" class="pkt-quick-btn"
                            :disabled="lines[@i].lineStatus === 'Skipped'"
                            @@click="adjust(@i, 10)">+10</button>
                </div>

                <div class="pkt-variance"
                     :class="varianceClass(@i)"
                     x-show="varianceText(@i)"
                     x-text="varianceText(@i)"></div>

                <div class="pkt-collapsible" x-show="lines[@i].trackingMethod !== 'LotAndSerial'">
                    <div class="pkt-field">
                        <div class="pkt-field-label">Status</div>
                        <select class="pkt-select"
                                name="Lines[@i].LineStatus"
                                x-model="lines[@i].lineStatus"
                                @@change="onStatusChange(@i)">
                            <option value="Packed">Packed</option>
                            <option value="Skipped">Skipped (cannot pack)</option>
                        </select>
                    </div>
                    <div class="pkt-field" x-show="needsReason(@i)">
                        <div class="pkt-field-label">
                            Reason
                            <span class="pkt-field-required" x-show="needsReason(@i)">*</span>
                        </div>
                        <input type="text" class="pkt-input-text"
                               name="Lines[@i].ShortPackReason"
                               x-model="lines[@i].shortPackReason"
                               placeholder="(required for short / skipped)" />
                    </div>
                    <div class="pkt-field">
                        <div class="pkt-field-label">Notes (optional)</div>
                        <input type="text" class="pkt-input-text"
                               name="Lines[@i].Notes"
                               x-model="lines[@i].notes" />
                    </div>
                </div>
            </div>
        }

        <div class="pkt-carton-card">
            <div class="pkt-carton-title">
                <i class="ti ti-package"></i> Carton metadata
            </div>
            <div class="pkt-field">
                <div class="pkt-field-label">Box type (optional)</div>
                <select class="pkt-select" name="BoxTypeId">
                    <option value="">— Choose box type —</option>
                    @foreach (var bt in boxTypes)
                    {
                        <option value="@bt.Id">@bt.Code · @bt.Name</option>
                    }
                </select>
            </div>
            <div class="pkt-field">
                <div class="pkt-field-label">Weight (kg, optional)</div>
                <input type="number" step="0.001" min="0"
                       class="pkt-input-text"
                       inputmode="decimal"
                       name="WeightKg"
                       placeholder="e.g. 2.450" />
            </div>
            <div class="pkt-field">
                <div class="pkt-field-label">Carton notes (optional)</div>
                <textarea class="pkt-textarea"
                          name="CartonNotes"
                          maxlength="500"></textarea>
            </div>
        </div>

        <div class="pkt-sticky">
            <button type="submit" class="pkt-submit"
                    :disabled="!isValid()">
                <i class="ti ti-check"></i> Submit pack
            </button>
        </div>
    </form>

    @* Cancel — separate form so it doesn't collide with submit. *@
    <form asp-controller="Pack" asp-action="Cancel"
          asp-route-taskId="@Model.Header.Id" method="post"
          onsubmit="return confirmPackCancel(this);"
          style="position:fixed;left:14px;right:14px;bottom:62px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reason" value="" />
        <button type="submit" class="pkt-cancel">
            <i class="ti ti-x"></i> Cancel pack task
        </button>
    </form>
</div>

@section Scripts {
    <script>
        function packTask(opts) {
            return {
                lines: opts.initialLines || [],
                adjust(idx, delta) {
                    const line = this.lines[idx];
                    if (line.lineStatus === 'Skipped') return;
                    const next = (line.packedQuantity || 0) + delta;
                    const ceiling = line.pickedQuantity || 0;
                    let value = next < 0 ? 0 : next;
                    // Server-side CK_PackTaskLines_PackedNotOverPicked
                    // is the authoritative cap; UI clamps to picked qty
                    // so the operator sees the bound rendered as a hint,
                    // not an error after submit.
                    if (value > ceiling) value = ceiling;
                    line.packedQuantity = value;
                },
                onStatusChange(idx) {
                    const line = this.lines[idx];
                    if (line.lineStatus === 'Skipped') {
                        // Skipped IS a short — the full picked qty.
                        // Service requires PackedQuantity = null on Skipped.
                        line.packedQuantity = null;
                    } else if (line.lineStatus === 'Packed' && line.packedQuantity == null) {
                        // Restore default when flipping back from Skipped.
                        line.packedQuantity = line.pickedQuantity;
                    }
                },
                varianceText(idx) {
                    const line = this.lines[idx];
                    if (line.lineStatus === 'Skipped') return '⊘ Skipped — full picked qty';
                    if (line.packedQuantity == null) return '';
                    const diff = line.packedQuantity - line.pickedQuantity;
                    if (diff === 0) return '✓ Matches picked';
                    if (diff < 0) return `↓ ${Math.abs(diff)} short of picked`;
                    return `↑ ${diff} over picked (will be capped)`;
                },
                varianceClass(idx) {
                    const line = this.lines[idx];
                    if (line.lineStatus === 'Skipped') return 'is-skip';
                    if (line.packedQuantity == null) return '';
                    const diff = line.packedQuantity - line.pickedQuantity;
                    if (diff === 0) return 'is-match';
                    if (diff < 0) return 'is-under';
                    return 'is-under';
                },
                needsReason(idx) {
                    const line = this.lines[idx];
                    if (line.trackingMethod === 'LotAndSerial') return false;
                    if (line.lineStatus === 'Skipped') return true;
                    return (line.packedQuantity ?? line.pickedQuantity) < line.pickedQuantity;
                },
                isValid() {
                    // Every line that needs a reason must have one with
                    // ≥3 chars (matches service-layer rule). Serial-
                    // tracked lines block submit entirely (controller
                    // guard catches even if checkbox bypassed).
                    if (this.lines.some(l => l.trackingMethod === 'LotAndSerial')) return false;
                    return this.lines.every(l => {
                        if (this.needsReason(this.lines.indexOf(l))) {
                            return (l.shortPackReason || '').trim().length >= 3;
                        }
                        return true;
                    });
                },
            };
        }

        function confirmPackCancel(form) {
            const reason = window.prompt('Cancel reason (required, min 3 chars):', '');
            if (reason === null) return false;
            const trimmed = (reason || '').trim();
            if (trimmed.length < 3) {
                alert('Reason must be at least 3 characters.');
                return false;
            }
            form.querySelector('input[name="reason"]').value = trimmed;
            return true;
        }
    </script>
}
