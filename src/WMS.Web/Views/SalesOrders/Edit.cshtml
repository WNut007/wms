@model WMS.Web.Models.Outbound.SalesOrderEditViewModel
@{
    Layout = "_OfficeLayout";
    ViewData["Title"] = $"Edit {Model.SoNumber}";

    var productsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Products.Select(p => new { id = p.Id, code = p.Code, name = p.Name }));
    var ownersJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Owners.Select(o => new { id = o.Id, code = o.Code, name = o.Name }));
    var uomsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Uoms.Select(u => new { id = u.Id, code = u.Code, name = u.Name }));
    var initialLinesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Lines.Select((l, i) => new {
            lineNumber      = l.LineNumber > 0 ? l.LineNumber : i + 1,
            productId       = l.ProductId == Guid.Empty ? "" : l.ProductId.ToString(),
            ownerId         = l.OwnerId == Guid.Empty ? "" : l.OwnerId.ToString(),
            uomId           = l.UomId == Guid.Empty ? "" : l.UomId.ToString(),
            orderedQuantity = l.OrderedQuantity,
            unitPrice       = (object?)l.UnitPrice ?? "",
            notes           = l.Notes ?? "",
        }));
}

<div class="wms-page-header">
    <div>
        <p class="wms-page-title">Edit @Model.SoNumber</p>
        <div class="wms-breadcrumb">
            <span>Operations</span>
            <span class="wms-breadcrumb-sep">/</span>
            <span>Outbound</span>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-action="Index">Sales Orders</a>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-action="Detail" asp-route-id="@Model.Id">@Model.SoNumber</a>
            <span class="wms-breadcrumb-sep">/</span>
            <span class="wms-breadcrumb-current">Edit</span>
        </div>
    </div>
    <div class="wms-page-actions">
        <a asp-action="Detail" asp-route-id="@Model.Id" class="wms-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
            Back
        </a>
    </div>
</div>

<form asp-controller="SalesOrders" asp-action="Edit" asp-route-id="@Model.Id" method="post"
      x-data="salesOrderEditForm({
          replaceLines: @(Model.ReplaceLines ? "true" : "false"),
          linesLocked:  @(Model.LinesLocked ? "true" : "false"),
          products:     @Html.Raw(productsJson),
          owners:       @Html.Raw(ownersJson),
          uoms:         @Html.Raw(uomsJson),
          initialLines: @Html.Raw(initialLinesJson)
      })">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    @if (ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div style="padding: 10px 14px; margin-bottom: 12px; background: #FCEBEB; color: #A32D2D; border-radius: 8px; font-size: 13px;">
            @foreach (var err in ViewData.ModelState[""]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">

        <div style="display: flex; flex-direction: column; gap: 12px;">

            <div class="wms-card" style="padding: 18px;">
                <h3 style="margin: 0 0 4px; font-size: 14px; font-weight: 500;">
                    <i class="ti ti-shopping-cart" style="color: #534AB7; margin-right: 6px;"></i>
                    Header
                </h3>
                <p style="margin: 0 0 16px; font-size: 12px; color: var(--wms-text-secondary);">
                    SO number, customer, and warehouse are frozen post-create.
                </p>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:500;margin-bottom:4px;">SO #</label>
                        <input class="wms-input mono" value="@Model.SoNumber" readonly disabled />
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:500;margin-bottom:4px;">Status</label>
                        <input class="wms-input" value="@Model.Status" readonly disabled />
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:500;margin-bottom:4px;">Customer</label>
                        <input class="wms-input" value="@Model.CustomerCode · @Model.CustomerName" readonly disabled />
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:500;margin-bottom:4px;">Warehouse</label>
                        <input class="wms-input" value="@Model.WarehouseCode · @Model.WarehouseName" readonly disabled />
                    </div>

                    <div>
                        <label asp-for="OrderDate" style="display:block;font-size:12px;font-weight:500;margin-bottom:4px;">Order date *</label>
                        <input asp-for="OrderDate" type="date" class="wms-input" required />
                        <span asp-validation-for="OrderDate" style="color:#A32D2D;font-size:11px;"></span>
                    </div>

                    <div>
                        <label asp-for="RequestedShipDate" style="display:block;font-size:12px;font-weight:500;margin-bottom:4px;">Requested ship date</label>
                        <input asp-for="RequestedShipDate" type="date" class="wms-input" />
                        <span asp-validation-for="RequestedShipDate" style="color:#A32D2D;font-size:11px;"></span>
                    </div>

                    <div style="grid-column: 1 / -1;">
                        <label asp-for="Notes" style="display:block;font-size:12px;font-weight:500;margin-bottom:4px;">Notes</label>
                        <textarea asp-for="Notes" class="wms-input" rows="2" maxlength="1000"></textarea>
                        <span asp-validation-for="Notes" style="color:#A32D2D;font-size:11px;"></span>
                    </div>
                </div>
            </div>

            <div class="wms-card" style="padding: 18px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                    <h3 style="margin: 0; font-size: 14px; font-weight: 500;">
                        <i class="ti ti-list-details" style="color: #534AB7; margin-right: 6px;"></i>
                        Lines
                        <span style="font-size:11px;color:var(--wms-text-secondary);font-weight:400;margin-left:6px;"
                              x-text="`${lines.length} line(s)`"></span>
                    </h3>
                </div>

                @if (Model.LinesLocked)
                {
                    <div style="padding:10px 14px; background:#FAEEDA; color:#854F0B; border-radius:8px; font-size:12px; margin-bottom:12px;">
                        <i class="ti ti-lock" aria-hidden="true"></i>
                        Lines are read-only — SO is in <strong>@Model.Status</strong> state.
                        Cancel and recreate to change line shape (Phase 14B will add allocation-aware line edit).
                    </div>
                }
                else
                {
                    <label style="display:flex; align-items:center; gap:6px; font-size:12px; margin-bottom:12px;">
                        <input asp-for="ReplaceLines" type="checkbox" x-model="replaceLines" />
                        Replace lines on save
                        <span style="color:var(--wms-text-secondary);">— uncheck for header-only edit</span>
                    </label>
                }

                <div style="overflow-x:auto;">
                    <table class="wms-table" style="width:100%;font-size:12px;">
                        <thead>
                            <tr>
                                <th style="width:36px;">#</th>
                                <th>Product</th>
                                <th style="width:120px;">Owner</th>
                                <th style="width:80px;">UoM</th>
                                <th style="width:100px;text-align:right;">Qty *</th>
                                <th style="width:100px;text-align:right;">Unit price</th>
                                <th>Notes</th>
                                <th style="width:36px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="(line, idx) in lines" :key="idx">
                                <tr :style="(linesLocked || !replaceLines) ? 'opacity:0.7;' : ''">
                                    <td>
                                        <input type="hidden" :name="`Lines[${idx}].LineNumber`" :value="idx + 1" />
                                        <span class="mono" x-text="idx + 1"></span>
                                    </td>
                                    <td>
                                        <select :name="`Lines[${idx}].ProductId`" class="wms-input" x-model="line.productId"
                                                :disabled="linesLocked || !replaceLines">
                                            <option value="">—</option>
                                            <template x-for="p in products" :key="p.id">
                                                <option :value="p.id" x-text="p.code + ' · ' + p.name"></option>
                                            </template>
                                        </select>
                                    </td>
                                    <td>
                                        <select :name="`Lines[${idx}].OwnerId`" class="wms-input" x-model="line.ownerId"
                                                :disabled="linesLocked || !replaceLines">
                                            <option value="">—</option>
                                            <template x-for="o in owners" :key="o.id">
                                                <option :value="o.id" x-text="o.code"></option>
                                            </template>
                                        </select>
                                    </td>
                                    <td>
                                        <select :name="`Lines[${idx}].UomId`" class="wms-input" x-model="line.uomId"
                                                :disabled="linesLocked || !replaceLines">
                                            <option value="">—</option>
                                            <template x-for="u in uoms" :key="u.id">
                                                <option :value="u.id" x-text="u.code"></option>
                                            </template>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" min="0.0001"
                                               :name="`Lines[${idx}].OrderedQuantity`" class="wms-input"
                                               style="text-align:right;"
                                               x-model.number="line.orderedQuantity"
                                               :disabled="linesLocked || !replaceLines" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" min="0"
                                               :name="`Lines[${idx}].UnitPrice`" class="wms-input"
                                               style="text-align:right;"
                                               x-model="line.unitPrice"
                                               :disabled="linesLocked || !replaceLines" />
                                    </td>
                                    <td>
                                        <input type="text" maxlength="500"
                                               :name="`Lines[${idx}].Notes`" class="wms-input"
                                               x-model="line.notes"
                                               :disabled="linesLocked || !replaceLines" />
                                    </td>
                                    <td style="text-align:center;">
                                        <button type="button" class="wms-btn" :disabled="linesLocked || !replaceLines || lines.length <= 1"
                                                @@click="removeLine(idx)" title="Remove line">
                                            <i class="ti ti-trash" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>

                @if (!Model.LinesLocked)
                {
                    <div style="margin-top:8px;">
                        <button type="button" class="wms-btn" :disabled="!replaceLines" @@click="addLine()">
                            <i class="ti ti-plus" aria-hidden="true"></i> Add line
                        </button>
                    </div>
                }
            </div>
        </div>

        <aside style="display: flex; flex-direction: column; gap: 12px;">
            <div class="wms-card" style="padding: 16px;">
                <p style="margin: 0 0 12px; font-size: 12px; color: var(--wms-text-secondary);">
                    Save header changes. Toggle <strong>Replace lines</strong> to update the line shape (Draft only).
                </p>
                <button type="submit" class="wms-btn wms-btn-purple" style="width: 100%;">
                    <i class="ti ti-device-floppy" style="margin-right: 6px;"></i>
                    Save changes
                </button>
                <a asp-action="Detail" asp-route-id="@Model.Id" class="wms-btn" style="width: 100%; display:block; text-align:center; margin-top: 8px;">
                    Cancel
                </a>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function salesOrderEditForm(opts) {
            return {
                replaceLines: opts.replaceLines,
                linesLocked:  opts.linesLocked,
                products:     opts.products  || [],
                owners:       opts.owners    || [],
                uoms:         opts.uoms      || [],
                lines:        (opts.initialLines && opts.initialLines.length > 0)
                                ? opts.initialLines
                                : [this._newLine(1)],

                _newLine(n) {
                    return {
                        lineNumber: n,
                        productId: '', ownerId: '', uomId: '',
                        orderedQuantity: 0, unitPrice: '', notes: '',
                    };
                },
                addLine() { this.lines.push(this._newLine(this.lines.length + 1)); },
                removeLine(idx) {
                    if (this.lines.length <= 1) return;
                    this.lines.splice(idx, 1);
                },
            };
        }
    </script>
}
