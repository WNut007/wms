@using WMS.Web.Models.Inbound
@model WMS.Web.Models.Inbound.PurchaseOrderEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.PoNumber}";
}

@* Block 4.5.2 chunk d.2 — Edit renders through the shared _PoForm
   partial with mode='edit'. Project this view's domain VM into the
   partial's contract (PurchaseOrderFormViewModel) via ToFormViewModel().
   Server-side POST still binds to PurchaseOrderEditViewModel — the
   partial's form-field names match across both VMs. *@
@await Html.PartialAsync("_PoForm", Model.ToFormViewModel())

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/wmsf-form-state.js" asp-append-version="true"></script>

    @* Block 4.5.2 grid libs + factories — same bundle as Create.cshtml.
       Loaded per-view (~110 KB combined); not worth adding to every
       authenticated page. Tom Select CSS via <link>; browsers parse
       <link> in body fine. *@
    <link rel="stylesheet" href="~/lib/tom-select/dist/css/tom-select.bootstrap5.min.css" />
    <script src="~/lib/sortablejs/dist/Sortable.min.js" asp-append-version="true"></script>
    <script src="~/lib/tom-select/dist/js/tom-select.complete.min.js" asp-append-version="true"></script>
    <script src="~/js/grids/grid-common.js" asp-append-version="true"></script>
    <script src="~/js/grids/po-line-grid.js" asp-append-version="true"></script>
}
