@using WMS.Web.Models.Inbound
@model WMS.Web.Models.Inbound.PurchaseOrderCreateViewModel
@{
    ViewData["Title"] = "New PO";
}

@* Block 4.5.2 chunk d.1 — Create renders through the shared _PoForm
   partial. Project this view's domain VM into the partial's contract
   (PurchaseOrderFormViewModel) via ToFormViewModel(). Form fields
   submit to PurchaseOrdersController.Create as before — the partial's
   asp-for tags generate the same `name="…"` attributes regardless of
   the partial's @model. *@
@await Html.PartialAsync("_PoForm", Model.ToFormViewModel())

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/wmsf-form-state.js" asp-append-version="true"></script>

    @* Block 4.5.2 grid libs + factories — loaded per-view (~110 KB
       combined; not worth adding to every authenticated page). Tom
       Select CSS via <link>; browsers parse <link> in body fine. *@
    <link rel="stylesheet" href="~/lib/tom-select/dist/css/tom-select.bootstrap5.min.css" />
    <script src="~/lib/sortablejs/dist/Sortable.min.js" asp-append-version="true"></script>
    <script src="~/lib/tom-select/dist/js/tom-select.complete.min.js" asp-append-version="true"></script>
    <script src="~/js/grids/grid-common.js" asp-append-version="true"></script>
    <script src="~/js/grids/po-line-grid.js" asp-append-version="true"></script>
}
