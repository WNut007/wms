@model WMS.Web.ViewModels.Security.ChangePasswordViewModel
@{
    Layout = "_OfficeLayout";
    ViewData["Title"] = "Change password";
}

<div class="wms-page-header">
    <div>
        <p class="wms-page-title">Change password</p>
        <div class="wms-breadcrumb">
            <span>Account</span>
            <span class="wms-breadcrumb-sep">/</span>
            <span class="wms-breadcrumb-current">Change password</span>
        </div>
    </div>
</div>

@if (TempData["AccountMessage"] is string okMsg)
{
    <div class="wms-banner wms-banner-success" style="margin-bottom: 12px;">@okMsg</div>
}

<form asp-action="ChangePassword" method="post" class="rp-chart-card"
      style="max-width: 540px;"
      data-av-form data-av-rules="length,upper,lower,digit" data-av-min-length="8">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="wms-banner wms-banner-danger"
         style="margin-bottom: 16px;"></div>

    <p class="rp-chart-title">Set new password</p>
    <p class="rp-chart-desc">
        Choose a strong password you haven't used elsewhere.
        Password change clears any active lockout.
    </p>

    <div style="display: grid; gap: 14px;">
        <div class="av-field">
            <label asp-for="CurrentPassword"></label>
            <div class="av-input-wrap">
                <input asp-for="CurrentPassword" class="wms-input"
                       autocomplete="current-password" />
                <button type="button" class="av-input-toggle"
                        aria-label="Show password"
                        data-av-toggle data-av-toggle-target="#CurrentPassword">
                    <i class="ti ti-eye"></i>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="wms-field-error"></span>
        </div>

        <div class="av-field">
            <label asp-for="NewPassword"></label>
            <div class="av-input-wrap">
                <input asp-for="NewPassword" class="wms-input"
                       autocomplete="new-password" data-av-new />
                <button type="button" class="av-input-toggle"
                        aria-label="Show password"
                        data-av-toggle data-av-toggle-target="#NewPassword">
                    <i class="ti ti-eye"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="wms-field-error"></span>

            <div class="av-strength" data-av-strength>
                <div class="av-strength-bar">
                    <div class="av-strength-segment"></div>
                    <div class="av-strength-segment"></div>
                    <div class="av-strength-segment"></div>
                    <div class="av-strength-segment"></div>
                </div>
                <div class="av-strength-label" data-av-strength-label></div>
            </div>

            <ul class="av-checklist">
                <li class="av-rule" data-av-rule="length">
                    <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                    <span>At least 8 characters</span>
                    <span class="av-rule-count" data-av-count></span>
                </li>
                <li class="av-rule" data-av-rule="upper">
                    <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                    <span>Uppercase letter (A-Z)</span>
                </li>
                <li class="av-rule" data-av-rule="lower">
                    <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                    <span>Lowercase letter (a-z)</span>
                </li>
                <li class="av-rule" data-av-rule="digit">
                    <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                    <span>Number (0-9)</span>
                </li>
            </ul>
        </div>

        <div class="av-field">
            <label asp-for="ConfirmPassword"></label>
            <div class="av-input-wrap">
                <input asp-for="ConfirmPassword" class="wms-input"
                       autocomplete="new-password" data-av-confirm />
                <button type="button" class="av-input-toggle"
                        aria-label="Show password"
                        data-av-toggle data-av-toggle-target="#ConfirmPassword">
                    <i class="ti ti-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="wms-field-error"></span>
            <div class="av-field-msg" data-av-match-msg></div>
        </div>
    </div>

    <div style="display: flex; gap: 8px; margin-top: 20px;">
        <button type="submit" class="wms-btn wms-btn-purple" data-av-submit>
            <span class="av-submit-text">
                <i class="ti ti-lock" aria-hidden="true"></i> Change password
            </span>
            <span class="av-submit-loading">
                <i class="ti ti-loader-2"></i>
                Changing password...
            </span>
        </button>
        <a href="/" class="wms-btn">Cancel</a>
    </div>
</form>

<style>
    label {
        font-size: 12px;
        color: var(--wms-text-secondary);
        font-weight: 500;
        display: block;
        margin-bottom: 4px;
    }
    .wms-field-error {
        display: block;
        font-size: 12px;
        color: #DC2626;
        margin-top: 4px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
