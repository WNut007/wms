@model WMS.Web.ViewModels.Detail.DetailPageViewModel
@{
    Layout = "_OfficeLayout";
    ViewData["Title"] = Model.Title;

    var editUrl = Model.EntityType switch
    {
        "Product"       => Url.Action("Edit", "Products",       new { code = Model.EntityId }),
        "Customer"      => Url.Action("Edit", "Customers",      new { code = Model.EntityId }),
        "Warehouse"     => Url.Action("Edit", "Warehouses",     new { code = Model.EntityId }),
        "PurchaseOrder" => Url.Action("Edit", "PurchaseOrders", new { id   = Model.EntityId }),
        "SalesOrder"    => Url.Action("Edit", "SalesOrders",    new { id   = Model.EntityId }),
        _ => null,
    };

    var statBgVariant = Model.Stats.Count switch
    {
        <= 2 => 2,
        3    => 3,
        _    => 4,
    };
}

<div class="wmsd-page">

    @* Phase 10B+ — TempData banners from POST redirects. Loosely
       coupled across surfaces: any "POST then redirect to Detail"
       can use these keys. CancelMessage/Error from Phase 10B
       (Receiving cancellation); AdjustmentMessage/Error from Phase
       11A. Both colour-classes inline to avoid coupling to a CSS
       module. *@
    @{
        var okMsg  = (TempData["CancelMessage"]     as string)
                  ?? (TempData["AdjustmentMessage"] as string)
                  ?? (TempData["CycleCountMessage"] as string)
                  ?? (TempData["TransferMessage"]   as string)
                  ?? (TempData["SalesOrderMessage"] as string)
                  ?? (TempData["PickTaskMessage"]   as string)
                  ?? (TempData["PackTaskMessage"]   as string)
                  ?? (TempData["ShipmentMessage"]   as string);
        var errMsg = (TempData["CancelError"]       as string)
                  ?? (TempData["AdjustmentError"]   as string)
                  ?? (TempData["CycleCountError"]   as string)
                  ?? (TempData["TransferError"]     as string)
                  ?? (TempData["SalesOrderError"]   as string)
                  ?? (TempData["PickTaskError"]     as string)
                  ?? (TempData["PackTaskError"]     as string)
                  ?? (TempData["ShipmentError"]     as string);
    }
    @if (!string.IsNullOrEmpty(okMsg))
    {
        <div style="padding: 10px 14px; background: #E1F5EE; color: #0F6E56; border-radius: 8px; font-size: 13px; display: flex; align-items: center; gap: 8px;">
            <i class="ti ti-check"></i> @okMsg
        </div>
    }
    @if (!string.IsNullOrEmpty(errMsg))
    {
        <div style="padding: 10px 14px; background: #FCEBEB; color: #A32D2D; border-radius: 8px; font-size: 13px; display: flex; align-items: center; gap: 8px;">
            <i class="ti ti-alert-circle"></i> @errMsg
        </div>
    }
    @* Phase 11A — explicit notice when the requester opens their own
       Pending adjustment. Approve/Reject buttons are disabled by VM
       gating; this banner explains why. *@
    @if (ViewBag.SelfApproval is true)
    {
        <div style="padding: 10px 14px; background: #FAEEDA; color: #854F0B; border-radius: 8px; font-size: 13px; display: flex; align-items: center; gap: 8px;">
            <i class="ti ti-info-circle"></i> You created this adjustment — another user must approve or reject it (separation of duties).
        </div>
    }

    <nav class="wmsd-crumb" aria-label="Breadcrumb">
        <a href="@Model.BreadcrumbParentUrl" class="wmsd-btn wmsd-btn-icon" title="Back" style="margin-right: 4px;">
            <i class="ti ti-arrow-left" aria-hidden="true"></i>
        </a>
        <span>Master Data</span>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <a href="@Model.BreadcrumbParentUrl">@Model.BreadcrumbParent</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <span class="current">@Model.EntityId</span>
    </nav>

    @* === Header card (gradient avatar · title · status · actions) === *@
    <header class="wmsd-head">
        <div class="wmsd-avatar" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarInitials))
            {
                @Model.AvatarInitials
            }
            else
            {
                <i class="ti @Model.IconClass"></i>
            }
        </div>

        <div class="wmsd-head-text">
            <div class="wmsd-head-title-row">
                <h1>@Model.Title</h1>
                @if (!string.IsNullOrEmpty(Model.StatusLabel))
                {
                    <span class="wmsd-badge s-@Model.StatusVariant">@Model.StatusLabel</span>
                }
                @foreach (var b in Model.Badges)
                {
                    <span class="wmsd-badge s-@b.Variant">@b.Label</span>
                }
            </div>
            <p class="wmsd-head-sub">@Model.Subtitle</p>
        </div>

        <div class="wmsd-head-actions">
            @if (editUrl is not null)
            {
                <a href="@editUrl" class="wmsd-btn wmsd-btn-primary">
                    <i class="ti ti-pencil" aria-hidden="true"></i> Edit
                </a>
            }
            <button type="button" class="wmsd-btn wmsd-btn-icon" aria-label="More actions">
                <i class="ti ti-dots-vertical" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    @* === Stat tiles === *@
    @if (Model.Stats.Any())
    {
        <div class="wmsd-stats" style="--wmsd-stat-cols: @statBgVariant;">
            @foreach (var stat in Model.Stats)
            {
                <div class="wmsd-stat">
                    <p class="wmsd-stat-label">@stat.Label</p>
                    <p class="wmsd-stat-value@(stat.AccentColor != null ? " success" : "")"
                       @(stat.AccentColor != null ? $"style=color:{stat.AccentColor}" : "")>@stat.Value</p>
                </div>
            }
        </div>
    }

    @* === Body grid (tabs left · sidebar right) === *@
    <div class="wmsd-body">

        <div class="wmsd-card">
            <div class="wmsd-tabs" id="detailTabs" role="tablist">
                <button type="button" class="wmsd-tab is-active" data-tab="overview" role="tab">
                    <i class="ti ti-info-circle" aria-hidden="true"></i> Overview
                </button>
                @if (Model.ShowImagesTab)
                {
                    <button type="button" class="wmsd-tab" data-tab="images" role="tab">
                        <i class="ti ti-photo" aria-hidden="true"></i> Images
                    </button>
                }
                @foreach (var tab in Model.CustomTabs)
                {
                    <button type="button" class="wmsd-tab" data-tab="@tab.Key" role="tab">
                        <i class="ti @tab.IconClass" aria-hidden="true"></i> @tab.Label
                        @if (tab.Count.HasValue)
                        {
                            <span class="wmsd-tab-count">@tab.Count.Value</span>
                        }
                    </button>
                }
                <button type="button" class="wmsd-tab" data-tab="documents" role="tab">
                    <i class="ti ti-files" aria-hidden="true"></i> Documents
                    <span class="wmsd-tab-count">@Model.Documents.Count</span>
                </button>
                <button type="button" class="wmsd-tab" data-tab="activity" role="tab">
                    <i class="ti ti-history" aria-hidden="true"></i> Activity
                </button>
            </div>

            <div class="wmsd-panel" data-panel="overview" role="tabpanel">
                @await Html.PartialAsync("Detail/_OverviewPanel", Model)
            </div>

            @if (Model.ShowImagesTab)
            {
                <div class="wmsd-panel is-hidden" data-panel="images" role="tabpanel">
                    @await Html.PartialAsync("Detail/_ImagesPanel", Model)
                </div>
            }

            @foreach (var tab in Model.CustomTabs)
            {
                <div class="wmsd-panel is-hidden" data-panel="@tab.Key" role="tabpanel">
                    @await Html.PartialAsync(tab.PartialName, Model)
                </div>
            }

            <div class="wmsd-panel is-hidden" data-panel="documents" role="tabpanel">
                @await Html.PartialAsync("Detail/_DocumentsPanel", Model)
            </div>

            <div class="wmsd-panel is-hidden" data-panel="activity" role="tabpanel">
                @await Html.PartialAsync("Detail/_ActivityPanel", Model)
            </div>
        </div>

        @* === Sidebar === *@
        <aside class="wmsd-sidebar">
            @if (Model.QuickActions.Any())
            {
                <div class="wmsd-side-card">
                    <p class="wmsd-side-label">Quick actions</p>
                    @foreach (var action in Model.QuickActions)
                    {
                        @if (action.Enabled)
                        {
                            <a href="@action.Url" class="wmsd-action">
                                <i class="ti @action.IconClass" aria-hidden="true"></i>
                                <span>@action.Label</span>
                            </a>
                        }
                        else
                        {
                            @* TD-017: target route doesn't exist yet (Phase 7+ admin CRUD).
                               Rendered muted + non-clickable so the operator sees what's
                               coming without hitting a "#" link that does nothing. *@
                            <span class="wmsd-action is-disabled" title="Coming in a future phase" aria-disabled="true">
                                <i class="ti @action.IconClass" aria-hidden="true"></i>
                                <span>@action.Label</span>
                            </span>
                        }
                    }
                </div>
            }
            @if (Model.Properties.Any())
            {
                <div class="wmsd-side-card">
                    <p class="wmsd-side-label">Properties</p>
                    @foreach (var kv in Model.Properties)
                    {
                        <div class="wmsd-meta">
                            <span class="wmsd-meta-key">@kv.Key</span>
                            <span class="wmsd-meta-value">@kv.Value</span>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>

    @* Phase 10B (TD-023) — cancel-receipt modal partial. Renders only
       on Receiving Detail when the receipt is Posted. CSS-only :target
       activation; the Quick Action's href="#cancel-modal" opens it. *@
    @if (ViewBag.HeaderId is Guid && ViewBag.IsPosted is true)
    {
        @await Html.PartialAsync("Detail/_CancelReceiptModal")
    }
    @* Phase 11A — Approve / Reject modals for Adjustment Detail.
       Renders only when the current user can decide (Pending state +
       not the requester per separation-of-duties). *@
    @if (ViewBag.HeaderId is Guid && ViewBag.CanDecide is true)
    {
        @await Html.PartialAsync("Detail/_AdjustmentDecisionModals")
    }
    @* Phase 12 — Submit / Apply / Cancel modals for CycleCount Detail.
       Each modal renders only when its corresponding ViewBag flag is
       true (IsCounting / CanApply / CanCancel) so unauthorized users
       don't see actionable affordances. *@
    @if (ViewBag.HeaderId is Guid && Model.EntityType == "CycleCount")
    {
        @await Html.PartialAsync("Detail/_CycleCountDecisionModals")
    }
    @* Phase 13 — Submit / Approve / Cancel / MarkLost modals for Transfer
       Detail. Each modal renders only when its corresponding ViewBag flag
       is true (CanSubmit / CanApprove / CanCancel / CanMarkLost). *@
    @if (ViewBag.HeaderId is Guid && Model.EntityType == "Transfer")
    {
        @await Html.PartialAsync("Detail/_TransferDecisionModals")
    }
    @* Phase 14A — Submit / Cancel modals for SalesOrder Detail.
       Each modal renders only when its corresponding ViewBag flag
       is true (CanSubmit / CanCancel). *@
    @if (ViewBag.HeaderId is Guid && Model.EntityType == "SalesOrder")
    {
        @await Html.PartialAsync("Detail/_SalesOrderDecisionModals")
    }
    @* Phase 14C — Cancel modal for PickTask Detail. Submit lives
       inline in the Lines panel (needs the per-line inputs in scope). *@
    @if (ViewBag.HeaderId is Guid && Model.EntityType == "PickTask")
    {
        @await Html.PartialAsync("Detail/_PickTaskDecisionModals")
    }
    @* Phase 14D — Cancel modal for PackTask Detail. Submit lives
       inline in the Lines panel (needs the per-line inputs + carton
       metadata in scope). *@
    @if (ViewBag.HeaderId is Guid && Model.EntityType == "PackTask")
    {
        @await Html.PartialAsync("Detail/_PackTaskDecisionModals")
    }
    @* Phase 14E — Cancel modal for Shipment Detail. Submit lives
       inline in the Dispatch panel (needs the carrier + tracking +
       notes inputs in scope). *@
    @if (ViewBag.HeaderId is Guid && Model.EntityType == "Shipment")
    {
        @await Html.PartialAsync("Detail/_ShipmentDecisionModals")
    }
</div>

@section Scripts {
    <script>
        (function () {
            const tabs = document.querySelectorAll('.wmsd-tab');
            const panels = document.querySelectorAll('.wmsd-panel');
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('is-active'));
                    tab.classList.add('is-active');
                    panels.forEach(p => {
                        p.classList.toggle('is-hidden', p.dataset.panel !== tab.dataset.tab);
                    });
                });
            });
        })();
    </script>
}
