<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - WMS</title>

    @* PWA manifest is per-workflow — each folder's _ViewStart sets
       ViewData["ManifestPath"] (defaults to /receive/ for back-compat). *@
    <link rel="manifest" href="@(ViewData["ManifestPath"] as string ?? "/receive/manifest.json")" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@@latest/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wms-custom.css" asp-append-version="true" />

    <script defer src="https://unpkg.com/htmx.org@@2.0.4"></script>
    <script defer src="https://unpkg.com/alpinejs@@3.14.1/dist/cdn.min.js"></script>
</head>
<body class="wms-mobile">
    <header class="wms-mobile-topbar d-flex align-items-center">
        <h1 class="h6 m-0 flex-grow-1 text-white">
            @(ViewData["Title"] ?? "WMS")
        </h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-sm btn-link text-white text-decoration-none">
                    Sign out
                </button>
            </form>
        }
    </header>

    <main class="wms-mobile-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@@latest/dist/js/tabler.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
