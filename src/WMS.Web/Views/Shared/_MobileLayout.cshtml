<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - WMS</title>

    @* PWA manifest is per-workflow (ε today serves /receive only). *@
    <link rel="manifest" href="/receive/manifest.json" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @*
        TODO: localise via libman/npm to drop the runtime CDN dependency.
        Same TODO as _OfficeLayout — OK for Phase 1 internal dev.
    *@
    <script defer src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.1/dist/cdn.min.js"></script>
</head>
<body class="wms-mobile">
    <header class="wms-mobile-topbar d-flex align-items-center">
        <h1 class="h6 m-0 flex-grow-1 text-white">
            @(ViewData["Title"] ?? "WMS")
        </h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Auth" asp-action="Logout"
               class="btn btn-sm btn-link text-white text-decoration-none">
                Sign out
            </a>
        }
    </header>

    <main class="wms-mobile-content">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
