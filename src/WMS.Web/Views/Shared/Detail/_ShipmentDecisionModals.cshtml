@*
    Phase 14E — Cancel modal for Shipment Detail. Same CSS-only :target
    activation as Phase 11A/12/13/14A/14C/14D. Renders only when
    CanCancel is true (Pending) so post-Submit terminals don't see an
    actionable affordance.

    Submit lives inline in _ShipmentDispatchPanel — needs the carrier +
    tracking + notes fields in scope.
*@

<style>
    .wms-sh-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .wms-sh-overlay:target { display: flex; }

    .wms-sh-modal {
        background: #fff;
        border-radius: 12px;
        max-width: 520px;
        width: 100%;
        padding: 24px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    }
    .wms-sh-modal h2 {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 500;
        display: flex; align-items: center; gap: 8px;
        color: #A32D2D;
    }
    .wms-sh-modal p.lead {
        margin: 0 0 16px;
        font-size: 13px;
        color: var(--wmsd-text-secondary, #6B7280);
    }
    .wms-sh-field { margin-bottom: 12px; }
    .wms-sh-field label {
        display: block;
        font-size: 12px;
        font-weight: 500;
        color: #374151;
        margin-bottom: 4px;
    }
    .wms-sh-field textarea {
        width: 100%;
        padding: 8px 10px;
        font-size: 13px;
        border-radius: 6px;
        border: 1px solid #D1D5DB;
        background: #fff;
        font-family: inherit;
        resize: vertical;
        min-height: 70px;
    }
    .wms-sh-actions {
        display: flex; justify-content: flex-end; gap: 8px;
        margin-top: 16px;
    }
    .wms-sh-btn {
        padding: 8px 16px; font-size: 13px; font-weight: 500;
        border-radius: 6px; border: 0.5px solid #D1D5DB;
        background: #fff; color: #374151;
        cursor: pointer; text-decoration: none; line-height: 1;
    }
    .wms-sh-btn:hover { background: #F3F4F6; }
    .wms-sh-btn.is-danger {
        background: #A32D2D; border-color: #A32D2D; color: #fff;
    }
    .wms-sh-btn.is-danger:hover { background: #8B2424; }
</style>

@if (ViewBag.CanCancel is true)
{
    <div id="cancel-ship-modal" class="wms-sh-overlay">
        <div class="wms-sh-modal" role="dialog">
            <h2>
                <i class="ti ti-x"></i> Cancel shipment
            </h2>
            <p class="lead">
                The SO state is <strong>not</strong> touched (Generate
                didn't flip it; the SO stays Packed). A different
                operator can re-Generate. No carton stamping is
                reversed (Pending shipments haven't claimed any
                cartons).
            </p>

            <form asp-controller="Shipments" asp-action="Cancel"
                  asp-route-id="@ViewBag.HeaderId" method="post">
                @Html.AntiForgeryToken()

                <div class="wms-sh-field">
                    <label for="cancel-ship-reason">Reason (3–500 chars)</label>
                    <textarea id="cancel-ship-reason"
                              name="Reason"
                              maxlength="500"
                              minlength="3"
                              required
                              placeholder="e.g. Carrier no-show; rescheduling"></textarea>
                </div>

                <div class="wms-sh-actions">
                    <a href="#" class="wms-sh-btn">Keep shipment</a>
                    <button type="submit" class="wms-sh-btn is-danger">Confirm cancellation</button>
                </div>
            </form>
        </div>
    </div>
}
