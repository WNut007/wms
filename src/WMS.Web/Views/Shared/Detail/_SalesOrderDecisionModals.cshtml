@*
    Phase 14A — Submit / Cancel modals for SalesOrder Detail. Same
    CSS-only :target activation pattern as Phase 11A/12/13. Each modal
    renders only when its corresponding ViewBag flag is true (CanSubmit
    / CanCancel / CanAllocate) so unauthorized users don't see
    actionable affordances.

    Phase 14B added Allocate modal. Cancel copy is conditional —
    mentions allocation release when SO is in an allocated state.
*@

<style>
    .wms-so-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .wms-so-overlay:target { display: flex; }

    .wms-so-modal {
        background: #fff;
        border-radius: 12px;
        max-width: 460px;
        width: 100%;
        padding: 24px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    }
    .wms-so-modal h2 {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .wms-so-modal h2.is-info    { color: #0C447C; }
    .wms-so-modal h2.is-success { color: #0F6E56; }
    .wms-so-modal h2.is-danger  { color: #A32D2D; }
    .wms-so-modal p.lead {
        margin: 0 0 16px;
        font-size: 13px;
        color: var(--wmsd-text-secondary, #6B7280);
    }
    .wms-so-actions {
        display: flex; justify-content: flex-end; gap: 8px;
        margin-top: 16px;
    }
    .wms-so-btn {
        padding: 8px 16px; font-size: 13px; font-weight: 500;
        border-radius: 6px; border: 0.5px solid #D1D5DB;
        background: #fff; color: #374151;
        cursor: pointer; text-decoration: none; line-height: 1;
    }
    .wms-so-btn:hover { background: #F3F4F6; }
    .wms-so-btn.is-info    { background: #0C447C; border-color: #0C447C; color: #fff; }
    .wms-so-btn.is-info:hover    { background: #0A3760; }
    .wms-so-btn.is-success { background: #0F6E56; border-color: #0F6E56; color: #fff; }
    .wms-so-btn.is-success:hover { background: #0B5A47; }
    .wms-so-btn.is-danger  { background: #A32D2D; border-color: #A32D2D; color: #fff; }
    .wms-so-btn.is-danger:hover  { background: #8B2424; }
</style>

@if (ViewBag.CanSubmit is true)
{
    <div id="submit-modal" class="wms-so-overlay">
        <div class="wms-so-modal" role="dialog">
            <h2 class="is-info">
                <i class="ti ti-send"></i> Submit sales order
            </h2>
            <p class="lead">
                Moves to <strong>Open</strong>. Lines lock after submit —
                cancel and recreate is the only path to change line shape
                until Phase 14B's allocation-aware line edit ships.
            </p>
            <form asp-controller="SalesOrders" asp-action="Submit"
                  asp-route-id="@ViewBag.HeaderId" method="post">
                @Html.AntiForgeryToken()
                <div class="wms-so-actions">
                    <a href="#" class="wms-so-btn">Cancel</a>
                    <button type="submit" class="wms-so-btn is-info">Confirm submit</button>
                </div>
            </form>
        </div>
    </div>
}

@if (ViewBag.CanAllocate is true)
{
    <div id="allocate-modal" class="wms-so-overlay">
        <div class="wms-so-modal" role="dialog">
            <h2 class="is-success">
                <i class="ti ti-tags"></i> Allocate stock
            </h2>
            <p class="lead">
                Reserves stock against this SO's lines using the
                <strong>FIFO</strong> strategy (oldest stock first).
                Per-line picks reduce <em>available</em> stock at the
                source rows; the pick step in 14C draws from these
                allocations. Re-run if more stock arrives later.
            </p>
            <form asp-controller="SalesOrders" asp-action="Allocate"
                  asp-route-id="@ViewBag.HeaderId" method="post">
                @Html.AntiForgeryToken()
                <div class="wms-so-actions">
                    <a href="#" class="wms-so-btn">Cancel</a>
                    <button type="submit" class="wms-so-btn is-success">Confirm allocate</button>
                </div>
            </form>
        </div>
    </div>
}

@if (ViewBag.CanGenerate is true)
{
    <div id="generate-modal" class="wms-so-overlay">
        <div class="wms-so-modal" role="dialog">
            <h2 class="is-info">
                <i class="ti ti-list-check"></i> Generate pick task
            </h2>
            <p class="lead">
                Snapshots the SO's Active allocations into a new pick
                task and flips the SO to <strong>Picking</strong>.
                Stock + allocation rows are <em>not</em> mutated yet —
                they're consumed when the picker submits actual
                quantities. Idempotent on already-Picking SOs (returns
                the existing task).
            </p>
            <form asp-controller="SalesOrders" asp-action="Generate"
                  asp-route-id="@ViewBag.HeaderId" method="post">
                @Html.AntiForgeryToken()
                <div class="wms-so-actions">
                    <a href="#" class="wms-so-btn">Cancel</a>
                    <button type="submit" class="wms-so-btn is-info">Confirm generate</button>
                </div>
            </form>
        </div>
    </div>
}

@if (ViewBag.CanCancel is true)
{
    <div id="cancel-modal" class="wms-so-overlay">
        <div class="wms-so-modal" role="dialog">
            <h2 class="is-danger">
                <i class="ti ti-x"></i> Cancel sales order
            </h2>
            <p class="lead">
                Terminates the sales order. Status flips to
                <strong>Cancelled</strong>.
                @if (ViewBag.IsAllocating is true || ViewBag.IsAllocated is true)
                {
                    <span>Any active allocations are <strong>released</strong>:
                    Stock.QuantityAllocated is decremented atomically and
                    line allocation totals reset to 0.</span>
                }
                else
                {
                    <span>No allocations to reverse at this state.</span>
                }
                If you need to record context, edit Notes before cancelling.
            </p>
            <form asp-controller="SalesOrders" asp-action="Cancel"
                  asp-route-id="@ViewBag.HeaderId" method="post">
                @Html.AntiForgeryToken()
                <div class="wms-so-actions">
                    <a href="#" class="wms-so-btn">Keep SO</a>
                    <button type="submit" class="wms-so-btn is-danger">Confirm cancellation</button>
                </div>
            </form>
        </div>
    </div>
}
