@model WMS.Web.ViewModels.Detail.DetailPageViewModel
@{
    var headerId = (Guid)ViewBag.HeaderId;
    var latest = ViewBag.LatestVideo as WMS.Domain.Entities.Outbound.PackVideo;
}

<section class="wmsd-section">
    <p class="wmsd-section-eyebrow">— Video</p>
    <h2>@(latest is null ? "Record video" : "Pack video")</h2>

    <p style="font-size:12px;color:var(--wms-text-secondary);margin-bottom:12px;">
        Record a short video showing the carton contents at sealing time. WebM/VP9 (Chromium browsers); microphone is muted by default. Soft cap 60 seconds. Auto-deleted after 10 days per ADR-009 retention policy.
    </p>

    @if (latest is not null)
    {
        <div style="margin-bottom:16px;">
            <video controls preload="metadata"
                   src="/PackTasks/Video/@latest.Id"
                   style="max-width:100%;border-radius:6px;background:#000;">
                Your browser does not support HTML5 video playback.
            </video>
            <div style="font-size:11px;color:var(--wms-text-tertiary);margin-top:6px;">
                Recorded @latest.RecordedAt.ToString("yyyy-MM-dd HH:mm:ss UTC") · Duration @latest.DurationSec s
            </div>
        </div>
    }

    @* Hidden form solely to render an anti-forgery token the
       upload fetch() can read by name. Form is never submitted. *@
    <form id="pack-video-antiforgery-form" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <div x-data="packVideoRecorder({ packTaskId: '@headerId' })">
        <div x-show="!isSupported" class="wms-banner-warning">
            <i class="ti ti-alert-triangle"></i>
            Video recording requires a modern browser with MediaRecorder support (Chrome, Edge, Brave). Safari is not supported in MVP — server-side transcoding is a future TD.
        </div>

        <div x-show="isSupported" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            <button type="button"
                    class="wms-btn wms-btn-purple"
                    x-show="!isRecording && !isUploading"
                    @@click="startRecording()">
                <i class="ti ti-record-mail" style="margin-right:6px;color:#A32D2D;"></i>
                Start recording
            </button>
            <button type="button"
                    class="wms-btn"
                    style="background:#A32D2D;color:#fff;border-color:#A32D2D;"
                    x-show="isRecording"
                    @@click="stopRecording()">
                <i class="ti ti-player-stop" style="margin-right:6px;"></i>
                Stop (<span x-text="elapsedSec"></span>s)
            </button>
            <span x-show="isUploading" style="font-size:12px;color:var(--wms-text-secondary);">
                <i class="ti ti-loader" style="animation:spin 1s linear infinite;"></i>
                Uploading…
            </span>
            <span x-show="errorMsg" style="font-size:12px;color:#A32D2D;" x-text="errorMsg"></span>
            <span x-show="elapsedSec > 60 && isRecording" style="font-size:12px;color:#854F0B;">
                ⚠ Past 60s soft cap — consider stopping
            </span>
        </div>

        <video x-show="isRecording" x-ref="preview"
               muted autoplay playsinline
               style="max-width:100%;margin-top:12px;border-radius:6px;background:#000;"></video>
    </div>
</section>

<style>
    .wms-banner-warning {
        background: #FAEEDA; color: #854F0B;
        padding: 10px 14px; border-radius: 8px;
        font-size: 13px; display: flex; align-items: center; gap: 8px;
        margin-bottom: 12px;
    }
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>

<script>
    function packVideoRecorder(opts) {
        return {
            packTaskId: opts.packTaskId,
            isSupported: typeof MediaRecorder !== 'undefined',
            isRecording: false,
            isUploading: false,
            errorMsg: '',
            elapsedSec: 0,
            _stream: null,
            _recorder: null,
            _chunks: [],
            _startedAt: 0,
            _timer: null,

            async startRecording() {
                this.errorMsg = '';
                this._chunks = [];
                this.elapsedSec = 0;
                try {
                    // Video only — audio:false per ADR-009 (privacy +
                    // bandwidth). The user is still prompted for camera
                    // permission on first use.
                    this._stream = await navigator.mediaDevices.getUserMedia({
                        video: { width: 1280, height: 720 },
                        audio: false,
                    });
                } catch (err) {
                    this.errorMsg = 'Camera access denied or unavailable.';
                    return;
                }

                this.$refs.preview.srcObject = this._stream;

                // Prefer VP9, fall back to whatever the browser offers.
                const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
                    ? 'video/webm;codecs=vp9'
                    : 'video/webm';
                this._recorder = new MediaRecorder(this._stream, { mimeType: mime });
                this._recorder.ondataavailable = e => {
                    if (e.data.size > 0) this._chunks.push(e.data);
                };
                this._recorder.onstop = () => this._finalize();
                this._recorder.start();
                this.isRecording = true;
                this._startedAt = Date.now();
                this._timer = setInterval(() => {
                    this.elapsedSec = Math.floor((Date.now() - this._startedAt) / 1000);
                }, 1000);
            },

            stopRecording() {
                if (!this._recorder) return;
                this._recorder.stop();
                clearInterval(this._timer);
                if (this._stream) {
                    this._stream.getTracks().forEach(t => t.stop());
                }
                this.isRecording = false;
            },

            async _finalize() {
                this.isUploading = true;
                const blob = new Blob(this._chunks, { type: 'video/webm' });
                const fileName = `pack-${this.packTaskId}-${Date.now()}.webm`;
                const fd = new FormData();
                fd.append('file', blob, fileName);
                fd.append('durationSec', String(this.elapsedSec));
                // Anti-forgery token from the parent layout's hidden form.
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) fd.append('__RequestVerificationToken', token);

                try {
                    const r = await fetch(`/PackTasks/UploadVideo/${this.packTaskId}`, {
                        method: 'POST',
                        body: fd,
                    });
                    if (!r.ok) {
                        const err = await r.json().catch(() => ({ error: `HTTP ${r.status}` }));
                        this.errorMsg = err.error || `Upload failed (${r.status}).`;
                    } else {
                        // Reload to surface the new <video> element.
                        // Future TD: append the player inline without
                        // a full reload.
                        window.location.reload();
                    }
                } catch (e) {
                    this.errorMsg = 'Network error during upload.';
                } finally {
                    this.isUploading = false;
                }
            },
        };
    }
</script>
