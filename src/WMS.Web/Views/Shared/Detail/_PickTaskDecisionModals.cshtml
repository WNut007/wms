@*
    Phase 14C — Cancel modal for PickTask Detail. Same CSS-only :target
    activation as Phase 11A/12/13/14A. Renders only when CanCancel is
    true (Pending or InProgress) so post-Submit terminals don't see an
    actionable affordance.

    Submit lives inline in _PickTaskLinesPanel — it needs the per-line
    inputs in scope, so a separate modal would mean duplicating the
    line table.
*@

<style>
    .wms-pt-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .wms-pt-overlay:target { display: flex; }

    .wms-pt-modal {
        background: #fff;
        border-radius: 12px;
        max-width: 520px;
        width: 100%;
        padding: 24px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    }
    .wms-pt-modal h2 {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 500;
        display: flex; align-items: center; gap: 8px;
        color: #A32D2D;
    }
    .wms-pt-modal p.lead {
        margin: 0 0 16px;
        font-size: 13px;
        color: var(--wmsd-text-secondary, #6B7280);
    }
    .wms-pt-field { margin-bottom: 12px; }
    .wms-pt-field label {
        display: block;
        font-size: 12px;
        font-weight: 500;
        color: #374151;
        margin-bottom: 4px;
    }
    .wms-pt-field textarea {
        width: 100%;
        padding: 8px 10px;
        font-size: 13px;
        border-radius: 6px;
        border: 1px solid #D1D5DB;
        background: #fff;
        font-family: inherit;
        resize: vertical;
        min-height: 70px;
    }
    .wms-pt-actions {
        display: flex; justify-content: flex-end; gap: 8px;
        margin-top: 16px;
    }
    .wms-pt-btn {
        padding: 8px 16px; font-size: 13px; font-weight: 500;
        border-radius: 6px; border: 0.5px solid #D1D5DB;
        background: #fff; color: #374151;
        cursor: pointer; text-decoration: none; line-height: 1;
    }
    .wms-pt-btn:hover { background: #F3F4F6; }
    .wms-pt-btn.is-danger {
        background: #A32D2D; border-color: #A32D2D; color: #fff;
    }
    .wms-pt-btn.is-danger:hover { background: #8B2424; }
</style>

@if (ViewBag.CanCancel is true)
{
    <div id="cancel-pick-modal" class="wms-pt-overlay">
        <div class="wms-pt-modal" role="dialog">
            <h2>
                <i class="ti ti-x"></i> Cancel pick task
            </h2>
            <p class="lead">
                Reverts the SO to <strong>Allocated</strong>. The task's
                allocations stay <strong>Active</strong> (they were never
                consumed — Submit is the only operation that mutates
                stock or allocation reservations). Re-Generate after
                cancel to start over with the same allocations.
            </p>

            <form asp-controller="PickTasks" asp-action="Cancel"
                  asp-route-id="@ViewBag.HeaderId" method="post">
                @Html.AntiForgeryToken()

                <div class="wms-pt-field">
                    <label for="cancel-pick-reason">Reason (3–500 chars)</label>
                    <textarea id="cancel-pick-reason"
                              name="Reason"
                              maxlength="500"
                              minlength="3"
                              required
                              placeholder="e.g. Picker unavailable; reassigning to a different shift"></textarea>
                </div>

                <div class="wms-pt-actions">
                    <a href="#" class="wms-pt-btn">Keep task</a>
                    <button type="submit" class="wms-pt-btn is-danger">Confirm cancellation</button>
                </div>
            </form>
        </div>
    </div>
}
