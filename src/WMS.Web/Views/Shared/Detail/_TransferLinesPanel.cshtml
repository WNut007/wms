@model WMS.Web.ViewModels.Detail.DetailPageViewModel
@{
    var lines = ViewBag.LineRows as IReadOnlyList<WMS.DAL.Repositories.Inventory.TransferOrderLineRow>
                ?? new List<WMS.DAL.Repositories.Inventory.TransferOrderLineRow>();
    var headerId = (Guid)ViewBag.HeaderId;
    var isApproved  = ViewBag.IsApproved  is true;
    var isInTransit = ViewBag.IsInTransit is true;
}

<section class="wmsd-section">
    <p class="wmsd-section-eyebrow">— Lines</p>

    @if (isApproved)
    {
        <h2>Dispatch entry</h2>
        <p style="font-size:12px;color:var(--wms-text-secondary);margin-bottom:12px;">
            Enter the actual picked quantity per line. Source stock decrements on submit.
            Lines you don't dispatch (qty = 0) stay Pending — re-dispatch later.
        </p>

        <form asp-controller="Transfers" asp-action="Dispatch" asp-route-id="@headerId" method="post" id="dispatch-form">
            @Html.AntiForgeryToken()

            <div style="overflow-x:auto;">
                <table class="wms-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>Product</th>
                            <th>From location</th>
                            <th>To location</th>
                            <th style="width:60px;">UoM</th>
                            <th style="width:90px;text-align:right;">Requested</th>
                            <th style="width:130px;">Dispatch qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < lines.Count; i++)
                        {
                            var line = lines[i];
                            <tr>
                                <td><span class="mono">@line.LineNumber</span></td>
                                <td>
                                    <span class="mono" style="font-weight:500;">@line.ProductCode</span>
                                    <span style="font-size:11px;color:var(--wms-text-secondary);display:block;">@line.ProductName</span>
                                </td>
                                <td><span class="mono">@line.FromLocationCode</span></td>
                                <td><span class="mono">@line.ToLocationCode</span></td>
                                <td><span class="mono">@line.UomCode</span></td>
                                <td style="text-align:right;">@line.QtyRequested.ToString("N2")</td>
                                <td>
                                    <input type="hidden" name="Lines[@i].LineId" value="@line.Id" />
                                    <input type="number" step="0.01" min="0" max="@line.QtyRequested.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           class="wms-input" style="text-align:right;"
                                           name="Lines[@i].QtyDispatched"
                                           value="@line.QtyRequested.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="display:flex;justify-content:flex-end;padding:14px 0 4px;">
                <button type="submit" class="wms-btn wms-btn-purple">
                    <i class="ti ti-truck-loading" style="margin-right:6px;"></i>
                    Dispatch transfer
                </button>
            </div>
        </form>
    }
    else if (isInTransit)
    {
        <h2>Receive entry</h2>
        <p style="font-size:12px;color:var(--wms-text-secondary);margin-bottom:12px;">
            Enter actual received qty per line. Lines short of dispatched qty go to Variance
            (loss recorded in QtyLossInTransit). Destination stock increments on submit.
        </p>

        <form asp-controller="Transfers" asp-action="Receive" asp-route-id="@headerId" method="post" id="receive-form">
            @Html.AntiForgeryToken()

            <div style="overflow-x:auto;">
                <table class="wms-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>Product</th>
                            <th>To location</th>
                            <th style="width:60px;">UoM</th>
                            <th style="width:90px;text-align:right;">Dispatched</th>
                            <th style="width:130px;">Received qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < lines.Count; i++)
                        {
                            var line = lines[i];
                            var dispatched = line.QtyDispatched ?? 0m;
                            <tr>
                                <td><span class="mono">@line.LineNumber</span></td>
                                <td>
                                    <span class="mono" style="font-weight:500;">@line.ProductCode</span>
                                    <span style="font-size:11px;color:var(--wms-text-secondary);display:block;">@line.ProductName</span>
                                </td>
                                <td><span class="mono">@line.ToLocationCode</span></td>
                                <td><span class="mono">@line.UomCode</span></td>
                                <td style="text-align:right;">@dispatched.ToString("N2")</td>
                                <td>
                                    <input type="hidden" name="Lines[@i].LineId" value="@line.Id" />
                                    <input type="number" step="0.01" min="0" max="@dispatched.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           class="wms-input" style="text-align:right;"
                                           name="Lines[@i].QtyReceived"
                                           value="@dispatched.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="display:flex;justify-content:flex-end;padding:14px 0 4px;">
                <button type="submit" class="wms-btn wms-btn-purple">
                    <i class="ti ti-package-import" style="margin-right:6px;"></i>
                    Receive transfer
                </button>
            </div>
        </form>
    }
    else
    {
        <h2>Transfer lines</h2>

        @if (lines.Count == 0)
        {
            <p style="text-align:center;padding:40px;color:var(--wms-text-tertiary);font-size:12px;">
                No lines on this transfer.
            </p>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="wms-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>Product</th>
                            <th>From → To</th>
                            <th style="width:60px;">UoM</th>
                            <th style="width:80px;text-align:right;">Requested</th>
                            <th style="width:80px;text-align:right;">Dispatched</th>
                            <th style="width:80px;text-align:right;">Received</th>
                            <th style="width:80px;text-align:right;">Loss</th>
                            <th style="width:110px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in lines)
                        {
                            var statusVariant = line.Status switch
                            {
                                "Pending"    => "s-warning",
                                "Dispatched" => "s-info",
                                "Received"   => "s-success",
                                "Variance"   => "s-danger",
                                _            => "s-neutral",
                            };
                            <tr>
                                <td><span class="mono">@line.LineNumber</span></td>
                                <td>
                                    <span class="mono" style="font-weight:500;">@line.ProductCode</span>
                                    <span style="font-size:11px;color:var(--wms-text-secondary);display:block;">@line.ProductName</span>
                                </td>
                                <td style="font-size:11px;">
                                    <span class="mono">@line.FromLocationCode</span>
                                    <span style="color:var(--wms-text-tertiary);"> → </span>
                                    <span class="mono">@line.ToLocationCode</span>
                                </td>
                                <td><span class="mono">@line.UomCode</span></td>
                                <td style="text-align:right;">@line.QtyRequested.ToString("N2")</td>
                                <td style="text-align:right;">@(line.QtyDispatched?.ToString("N2") ?? "—")</td>
                                <td style="text-align:right;">@(line.QtyReceived?.ToString("N2") ?? "—")</td>
                                <td style="text-align:right;@(line.QtyLossInTransit > 0m ? "color:#A32D2D;font-weight:500;" : "")">
                                    @(line.QtyLossInTransit > 0m ? line.QtyLossInTransit.ToString("N2") : "—")
                                </td>
                                <td><span class="wmsd-badge @statusVariant">@line.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>
