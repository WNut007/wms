@*
    Phase 10B (TD-023) — cancel-receipt confirmation modal.

    CSS-only :target approach: clicking a link with href="#cancel-modal"
    activates :target on the overlay, flipping display:none → flex.
    Stateless, no JS framework needed. The close button uses href="#"
    to clear the hash and dismiss.

    Rendered conditionally by _DetailLayout when ViewBag.HeaderId is
    set AND ViewBag.IsPosted is true (only Posted receipts can be
    cancelled). Form posts to /Receiving/Cancel/{id} which validates,
    runs the reverse orchestration in a TransactionScope, and
    redirects back to Detail with TempData success/error.
*@

<style>
    .wms-cancel-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .wms-cancel-overlay:target { display: flex; }

    .wms-cancel-modal {
        background: #fff;
        border-radius: 12px;
        max-width: 480px;
        width: 100%;
        padding: 24px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    }
    .wms-cancel-modal h2 {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 500;
        color: #A32D2D;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .wms-cancel-modal p.lead {
        margin: 0 0 16px;
        font-size: 13px;
        color: var(--wmsd-text-secondary, #6B7280);
    }
    .wms-cancel-modal label {
        display: block;
        margin: 0 0 4px;
        font-size: 12px;
        font-weight: 500;
    }
    .wms-cancel-modal textarea {
        width: 100%;
        min-height: 84px;
        padding: 8px 10px;
        font-size: 13px;
        font-family: inherit;
        border: 1px solid #D1D5DB;
        border-radius: 6px;
        resize: vertical;
        box-sizing: border-box;
    }
    .wms-cancel-modal textarea:focus {
        outline: none;
        border-color: #534AB7;
        box-shadow: 0 0 0 3px rgba(83, 74, 183, 0.15);
    }
    .wms-cancel-modal .wms-cancel-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 16px;
    }
    .wms-cancel-btn {
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        border-radius: 6px;
        border: 0.5px solid #D1D5DB;
        background: #fff;
        color: #374151;
        cursor: pointer;
        text-decoration: none;
        line-height: 1;
    }
    .wms-cancel-btn:hover { background: #F3F4F6; }
    .wms-cancel-btn.is-danger {
        background: #A32D2D;
        border-color: #A32D2D;
        color: #fff;
    }
    .wms-cancel-btn.is-danger:hover { background: #8B2424; }
</style>

<div id="cancel-modal" class="wms-cancel-overlay">
    <div class="wms-cancel-modal" role="dialog" aria-labelledby="cancel-modal-title">
        <h2 id="cancel-modal-title">
            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
            Cancel receipt
        </h2>
        <p class="lead">
            This reverses all stock movements from this receipt and reverts the linked
            PO's status. The action is logged in the activity feed and cannot be undone.
        </p>

        <form asp-controller="Receiving" asp-action="Cancel"
              asp-route-id="@ViewBag.HeaderId" method="post">
            @Html.AntiForgeryToken()

            <label for="cancel-reason">Reason (required, 3–500 chars)</label>
            <textarea id="cancel-reason" name="Reason"
                      required minlength="3" maxlength="500"
                      placeholder="e.g. supplier sent wrong SKU; returning shipment"></textarea>

            <div class="wms-cancel-actions">
                <a href="#" class="wms-cancel-btn">Keep receipt</a>
                <button type="submit" class="wms-cancel-btn is-danger">
                    Confirm cancellation
                </button>
            </div>
        </form>
    </div>
</div>
