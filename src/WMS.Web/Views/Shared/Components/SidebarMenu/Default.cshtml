@model IReadOnlyList<WMS.Web.ViewComponents.ModuleItem>
@{
    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    bool IsActive(string code) =>
        string.Equals(currentController, code, StringComparison.OrdinalIgnoreCase);

    var operationsCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    { "INBOUND", "INVENTORY", "OUTBOUND", "RETURNS", "COUNTS" };
    var operations = Model.Where(m => operationsCodes.Contains(m.Code)).ToList();
    var system     = Model.Where(m => !operationsCodes.Contains(m.Code)).ToList();
}

<div class="wms-sidebar-logo">
    <div class="wms-sidebar-logo-icon">
        <i class="ti ti-package" style="font-size: 16px; color: white;"></i>
    </div>
    <span class="wms-sidebar-logo-text">WMS</span>
    <span class="wms-sidebar-version">v1.0</span>
</div>

<div class="wms-sidebar-search">
    <div class="wms-sidebar-search-box">
        <i class="ti ti-search" style="font-size: 13px;"></i>
        <span>Filter</span>
    </div>
</div>

<p class="wms-sidebar-section">Operations</p>

<a href="@Url.Action("Index", "Home")"
   class="wms-sidebar-item @(IsActive("Home") ? "active" : "")"
   title="Dashboard">
    <i class="ti ti-home wms-sidebar-item-icon"></i>
    <span class="wms-sidebar-item-text">Dashboard</span>
</a>

@foreach (var module in operations)
{
    if (string.Equals(module.Code, "INBOUND", StringComparison.OrdinalIgnoreCase))
    {
        // Phase 9A — Inbound expands to Purchase Orders submenu (and
        // future GR + ASN entries when 9B + 9C land).
        var inboundActive = IsActive("INBOUND") || IsActive("PurchaseOrders")
            || IsActive("GoodsReceipt") || IsActive("Receiving") || IsActive("Receive");
        <a href="@Url.Action("Index", "PurchaseOrders")"
           class="wms-sidebar-item @(inboundActive ? "active" : "")"
           title="@module.DisplayName">
            <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
            <span class="wms-sidebar-item-text">@module.DisplayName</span>
            <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
        </a>
        <div class="wms-sidebar-submenu">
            <a href="@Url.Action("Index", "PurchaseOrders")"
               class="wms-sidebar-item @(IsActive("PurchaseOrders") ? "active" : "")">
                <span class="wms-sidebar-item-text">Purchase Orders</span>
            </a>
            <a href="@Url.Action("Create", "GoodsReceipt")"
               class="wms-sidebar-item @(IsActive("GoodsReceipt") ? "active" : "")">
                <span class="wms-sidebar-item-text">Goods Receipt (new)</span>
            </a>
            <a href="@Url.Action("Index", "Receiving")"
               class="wms-sidebar-item @(IsActive("Receiving") ? "active" : "")">
                <span class="wms-sidebar-item-text">Receipts</span>
            </a>
            <a href="@Url.Action("Index", "Receive")"
               class="wms-sidebar-item @(IsActive("Receive") ? "active" : "")">
                <span class="wms-sidebar-item-text">Receive (mobile)</span>
            </a>
            <a href="@Url.Action("Index", "Putaway")"
               class="wms-sidebar-item @(IsActive("Putaway") ? "active" : "")">
                <span class="wms-sidebar-item-text">Putaway (mobile)</span>
            </a>
        </div>
    }
    else if (string.Equals(module.Code, "COUNTS", StringComparison.OrdinalIgnoreCase))
    {
        // Phase 12 — Cycle Counts (desktop). Phase 21 — Cycle Count
        // (mobile): /count/ PWA queue + per-session count entry.
        var countsActive = IsActive("COUNTS") || IsActive("CycleCounts") || IsActive("Count");
        <a href="@Url.Action("Index", "CycleCounts")"
           class="wms-sidebar-item @(countsActive ? "active" : "")"
           title="@module.DisplayName">
            <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
            <span class="wms-sidebar-item-text">@module.DisplayName</span>
            <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
        </a>
        <div class="wms-sidebar-submenu">
            <a href="@Url.Action("Index", "CycleCounts")"
               class="wms-sidebar-item @(IsActive("CycleCounts") ? "active" : "")">
                <span class="wms-sidebar-item-text">Cycle Counts</span>
            </a>
            <a href="@Url.Action("Index", "Count")"
               class="wms-sidebar-item @(IsActive("Count") ? "active" : "")">
                <span class="wms-sidebar-item-text">Cycle Count (mobile)</span>
            </a>
        </div>
    }
    else if (string.Equals(module.Code, "INVENTORY", StringComparison.OrdinalIgnoreCase))
    {
        // Phase 11A + 13 — Inventory submenu: Adjustments + Transfers.
        // Future: Stock browser, Lots, Pallets.
        var inventoryActive = IsActive("INVENTORY") || IsActive("Adjustments") || IsActive("Transfers") || IsActive("Locate");
        <a href="@Url.Action("Index", "Adjustments")"
           class="wms-sidebar-item @(inventoryActive ? "active" : "")"
           title="@module.DisplayName">
            <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
            <span class="wms-sidebar-item-text">@module.DisplayName</span>
            <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
        </a>
        <div class="wms-sidebar-submenu">
            <a href="@Url.Action("Index", "Adjustments")"
               class="wms-sidebar-item @(IsActive("Adjustments") ? "active" : "")">
                <span class="wms-sidebar-item-text">Adjustments</span>
            </a>
            <a href="@Url.Action("Index", "Transfers")"
               class="wms-sidebar-item @(IsActive("Transfers") ? "active" : "")">
                <span class="wms-sidebar-item-text">Transfers</span>
            </a>
            <a href="@Url.Action("Index", "Locate")"
               class="wms-sidebar-item @(IsActive("Locate") ? "active" : "")">
                <span class="wms-sidebar-item-text">Locate (mobile)</span>
            </a>
        </div>
    }
    else if (string.Equals(module.Code, "OUTBOUND", StringComparison.OrdinalIgnoreCase))
    {
        // Phase 14A — Sales Orders.
        // Phase 14C/D/E added Pick / Pack / Shipment execution surfaces.
        // Phase 15A added list pages (Index actions) — submenu fills out
        // T1/T2/T3 chunk-by-chunk as each list lands.
        var outboundActive = IsActive("OUTBOUND")
            || IsActive("SalesOrders") || IsActive("PickTasks")
            || IsActive("PackTasks") || IsActive("Shipments")
            || IsActive("Pick") || IsActive("Pack");
        <a href="@Url.Action("Index", "SalesOrders")"
           class="wms-sidebar-item @(outboundActive ? "active" : "")"
           title="@module.DisplayName">
            <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
            <span class="wms-sidebar-item-text">@module.DisplayName</span>
            <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
        </a>
        <div class="wms-sidebar-submenu">
            <a href="@Url.Action("Index", "SalesOrders")"
               class="wms-sidebar-item @(IsActive("SalesOrders") ? "active" : "")">
                <span class="wms-sidebar-item-text">Sales Orders</span>
            </a>
            <a href="@Url.Action("Index", "PickTasks")"
               class="wms-sidebar-item @(IsActive("PickTasks") ? "active" : "")">
                <span class="wms-sidebar-item-text">Pick Tasks</span>
            </a>
            <a href="@Url.Action("Index", "PackTasks")"
               class="wms-sidebar-item @(IsActive("PackTasks") ? "active" : "")">
                <span class="wms-sidebar-item-text">Pack Tasks</span>
            </a>
            <a href="@Url.Action("Index", "Shipments")"
               class="wms-sidebar-item @(IsActive("Shipments") ? "active" : "")">
                <span class="wms-sidebar-item-text">Shipments</span>
            </a>
            <a href="@Url.Action("Index", "Pick")"
               class="wms-sidebar-item @(IsActive("Pick") ? "active" : "")">
                <span class="wms-sidebar-item-text">Pick (mobile)</span>
            </a>
            <a href="@Url.Action("Index", "Pack")"
               class="wms-sidebar-item @(IsActive("Pack") ? "active" : "")">
                <span class="wms-sidebar-item-text">Pack (mobile)</span>
            </a>
        </div>
    }
    else
    {
        <a href="@module.Url"
           class="wms-sidebar-item @(IsActive(module.Code) ? "active" : "")"
           title="@module.DisplayName">
            <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
            <span class="wms-sidebar-item-text">@module.DisplayName</span>
        </a>
    }
}

@if (system.Count > 0)
{
    <div class="wms-sidebar-divider"></div>

    <p class="wms-sidebar-section">System</p>

    @foreach (var module in system)
    {
        if (string.Equals(module.Code, "REPORTS", StringComparison.OrdinalIgnoreCase))
        {
            // Phase 23 — Reports submenu: Inventory dashboard, Order
            // analytics, Operational KPIs. Module surfaces when the user
            // has REPORTS.VIEW (seeded by Migration_033, granted to
            // MANAGER by Migration_034; ADMIN gets it via BLL bypass).
            var reportsActive = IsActive("REPORTS") || IsActive("Reports");
            <a href="@Url.Action("Index", "Reports")"
               class="wms-sidebar-item @(reportsActive ? "active" : "")"
               title="@module.DisplayName">
                <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
                <span class="wms-sidebar-item-text">@module.DisplayName</span>
                <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
            </a>
            <div class="wms-sidebar-submenu">
                <a href="@Url.Action("Index", "Reports")"
                   class="wms-sidebar-item">
                    <span class="wms-sidebar-item-text">Overview</span>
                </a>
                <a href="@Url.Action("Inventory", "Reports")"
                   class="wms-sidebar-item">
                    <span class="wms-sidebar-item-text">Inventory</span>
                </a>
                <a href="@Url.Action("Orders", "Reports")"
                   class="wms-sidebar-item">
                    <span class="wms-sidebar-item-text">Order Analytics</span>
                </a>
                <a href="@Url.Action("Kpis", "Reports")"
                   class="wms-sidebar-item">
                    <span class="wms-sidebar-item-text">Operational KPIs</span>
                </a>
            </div>
        }
        else if (string.Equals(module.Code, "MASTER", StringComparison.OrdinalIgnoreCase))
        {
            // Master Data — Phase 3 wired Warehouses; Phase 4 added
            // Products + Customers list/detail pages.
            var masterActive = IsActive("MASTER") || IsActive("Warehouses") || IsActive("Products") || IsActive("Customers");
            <a href="@Url.Action("Index", "Warehouses")"
               class="wms-sidebar-item @(masterActive ? "active" : "")"
               title="@module.DisplayName">
                <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
                <span class="wms-sidebar-item-text">@module.DisplayName</span>
                <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
            </a>
            <div class="wms-sidebar-submenu">
                <a href="@Url.Action("Index", "Warehouses")"
                   class="wms-sidebar-item @(IsActive("Warehouses") ? "active" : "")">
                    <span class="wms-sidebar-item-text">Warehouses</span>
                </a>
                <a href="@Url.Action("Index", "Products")"
                   class="wms-sidebar-item @(IsActive("Products") ? "active" : "")">
                    <span class="wms-sidebar-item-text">Products</span>
                </a>
                <a href="@Url.Action("Index", "Customers")"
                   class="wms-sidebar-item @(IsActive("Customers") ? "active" : "")">
                    <span class="wms-sidebar-item-text">Customers</span>
                </a>
            </div>
        }
        else
        {
            <a href="@module.Url"
               class="wms-sidebar-item @(IsActive(module.Code) ? "active" : "")"
               title="@module.DisplayName">
                <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
                <span class="wms-sidebar-item-text">@module.DisplayName</span>
            </a>
        }
    }
}
