@model IReadOnlyList<WMS.Web.ViewComponents.ModuleItem>
@{
    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    bool IsActive(string code) =>
        string.Equals(currentController, code, StringComparison.OrdinalIgnoreCase);

    var operationsCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    { "INBOUND", "INVENTORY", "OUTBOUND", "RETURNS", "COUNTS" };
    var operations = Model.Where(m => operationsCodes.Contains(m.Code)).ToList();
    var system     = Model.Where(m => !operationsCodes.Contains(m.Code)).ToList();
}

<div class="wms-sidebar-logo">
    <div class="wms-sidebar-logo-icon">
        <i class="ti ti-package" style="font-size: 16px; color: white;"></i>
    </div>
    <span class="wms-sidebar-logo-text">WMS</span>
    <span class="wms-sidebar-version">v1.0</span>
</div>

<div class="wms-sidebar-search">
    <div class="wms-sidebar-search-box">
        <i class="ti ti-search" style="font-size: 13px;"></i>
        <span>Filter</span>
    </div>
</div>

<p class="wms-sidebar-section">Operations</p>

<a href="@Url.Action("Index", "Home")"
   class="wms-sidebar-item @(IsActive("Home") ? "active" : "")"
   title="Dashboard">
    <i class="ti ti-home wms-sidebar-item-icon"></i>
    <span class="wms-sidebar-item-text">Dashboard</span>
</a>

@foreach (var module in operations)
{
    if (string.Equals(module.Code, "INBOUND", StringComparison.OrdinalIgnoreCase))
    {
        // Phase 9A — Inbound expands to Purchase Orders submenu (and
        // future GR + ASN entries when 9B + 9C land).
        var inboundActive = IsActive("INBOUND") || IsActive("PurchaseOrders") || IsActive("Receive");
        <a href="@Url.Action("Index", "PurchaseOrders")"
           class="wms-sidebar-item @(inboundActive ? "active" : "")"
           title="@module.DisplayName">
            <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
            <span class="wms-sidebar-item-text">@module.DisplayName</span>
            <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
        </a>
        <div class="wms-sidebar-submenu">
            <a href="@Url.Action("Index", "PurchaseOrders")"
               class="wms-sidebar-item @(IsActive("PurchaseOrders") ? "active" : "")">
                <span class="wms-sidebar-item-text">Purchase Orders</span>
            </a>
            <a href="@Url.Action("Index", "Receive")"
               class="wms-sidebar-item @(IsActive("Receive") ? "active" : "")">
                <span class="wms-sidebar-item-text">Receive (mobile)</span>
            </a>
        </div>
    }
    else
    {
        <a href="@module.Url"
           class="wms-sidebar-item @(IsActive(module.Code) ? "active" : "")"
           title="@module.DisplayName">
            <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
            <span class="wms-sidebar-item-text">@module.DisplayName</span>
        </a>
    }
}

@if (system.Count > 0)
{
    <div class="wms-sidebar-divider"></div>

    <p class="wms-sidebar-section">System</p>

    @foreach (var module in system)
    {
        if (string.Equals(module.Code, "MASTER", StringComparison.OrdinalIgnoreCase))
        {
            // Master Data — Phase 3 wired Warehouses; Phase 4 added
            // Products + Customers list/detail pages.
            var masterActive = IsActive("MASTER") || IsActive("Warehouses") || IsActive("Products") || IsActive("Customers");
            <a href="@Url.Action("Index", "Warehouses")"
               class="wms-sidebar-item @(masterActive ? "active" : "")"
               title="@module.DisplayName">
                <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
                <span class="wms-sidebar-item-text">@module.DisplayName</span>
                <i class="ti ti-chevron-down wms-sidebar-item-chevron"></i>
            </a>
            <div class="wms-sidebar-submenu">
                <a href="@Url.Action("Index", "Warehouses")"
                   class="wms-sidebar-item @(IsActive("Warehouses") ? "active" : "")">
                    <span class="wms-sidebar-item-text">Warehouses</span>
                </a>
                <a href="@Url.Action("Index", "Products")"
                   class="wms-sidebar-item @(IsActive("Products") ? "active" : "")">
                    <span class="wms-sidebar-item-text">Products</span>
                </a>
                <a href="@Url.Action("Index", "Customers")"
                   class="wms-sidebar-item @(IsActive("Customers") ? "active" : "")">
                    <span class="wms-sidebar-item-text">Customers</span>
                </a>
            </div>
        }
        else
        {
            <a href="@module.Url"
               class="wms-sidebar-item @(IsActive(module.Code) ? "active" : "")"
               title="@module.DisplayName">
                <i class="ti @module.IconClass wms-sidebar-item-icon"></i>
                <span class="wms-sidebar-item-text">@module.DisplayName</span>
            </a>
        }
    }
}
