@using System.Security.Claims
@using WMS.Common.Auth
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS</title>

    @*
        Tabler.io is Bootstrap 5 + design overrides — single CSS source.
        TODO(TD-XXX): localise CDN assets before production.
    *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@@latest/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wms-custom.css" asp-append-version="true" />

    <script defer src="https://unpkg.com/htmx.org@@2.0.4"></script>
    <script defer src="https://unpkg.com/alpinejs@@3.14.1/dist/cdn.min.js"></script>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="page">
            <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
                <div class="container-fluid">
                    <h1 class="navbar-brand navbar-brand-autodark">
                        <a asp-controller="Home" asp-action="Index" class="d-flex flex-column lh-sm">
                            <span class="fs-3 fw-bold">WMS</span>
                            <span class="small text-secondary fw-normal">Warehouse Management</span>
                        </a>
                    </h1>
                    @await Component.InvokeAsync("SidebarMenu")
                </div>
            </aside>

            <div class="page-wrapper">
                <header class="navbar navbar-expand-md d-print-none">
                    <div class="container-xl">
                        <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
                            <li class="breadcrumb-item">
                                @User.FindFirst(WmsClaimTypes.TenantCode)?.Value
                            </li>
                            <li class="breadcrumb-item active">
                                @User.FindFirst(WmsClaimTypes.WarehouseCode)?.Value
                            </li>
                        </ol>
                        <div class="navbar-nav flex-row order-md-last ms-auto">
                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link d-flex lh-1 text-reset p-0 px-2"
                                   data-bs-toggle="dropdown" aria-label="Open user menu">
                                    <span class="avatar avatar-sm">
                                        @(User.Identity!.Name?.Substring(0, 1).ToUpperInvariant() ?? "?")
                                    </span>
                                    <div class="d-none d-xl-block ps-2">
                                        <div>@User.Identity!.Name</div>
                                        <div class="mt-1 small text-secondary">
                                            @User.FindFirst(ClaimTypes.Email)?.Value
                                        </div>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                    <a class="dropdown-item" href="#">Profile</a>
                                    <a class="dropdown-item" href="#">Settings</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">
                                        Sign out
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="page-body">
                    <div class="container-xl">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Anonymous fallback (e.g. error page hit pre-login) — no shell. *@
        <div class="page-wrapper">
            <div class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@@latest/dist/js/tabler.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
