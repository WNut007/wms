@model WMS.DAL.Repositories.Inbound.ReceivingDetail
@{
    ViewData["Title"] = "Receipt posted";
}

<div class="alert alert-success mb-3" role="alert">
    <h6 class="alert-heading">Receipt posted</h6>
    <div><strong>@Model.Header.ReceivingNumber</strong></div>
    <div class="text-muted small">
        @Model.Header.ReceivedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
    </div>
</div>

<div class="card mb-3">
    <div class="card-body p-2">
        <h6 class="card-title px-2 pt-1 mb-1">Lines (@Model.Lines.Count)</h6>
        @foreach (var line in Model.Lines)
        {
            <div class="border-top px-2 py-2">
                <div class="d-flex justify-content-between">
                    <strong>Line @line.LineNumber</strong>
                    <span>qty @line.ReceivedQuantity</span>
                </div>
                @if (!string.IsNullOrEmpty(line.LotNumber))
                {
                    <div class="text-muted small">Lot: @line.LotNumber</div>
                }
                @if (!string.IsNullOrEmpty(line.PalletNumber))
                {
                    <div class="text-muted small">Pallet: @line.PalletNumber</div>
                }
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-primary btn-lg w-100">Receive another</a>
