@model WMS.Web.Models.Auth.WarehouseSelectViewModel
@{
    ViewData["Title"] = "Select warehouse";
}

<div class="wms-login-page">
    <aside class="wms-login-hero">
        <div class="wms-login-hero-content">
            <div class="wms-login-logo">
                <div class="wms-login-logo-icon">
                    <i class="ti ti-package" style="font-size: 22px; color: white;"></i>
                </div>
                <span class="wms-login-logo-text">WMS</span>
            </div>

            <p style="font-size: 11px; opacity: 0.7; text-transform: uppercase; letter-spacing: 0.4px; font-weight: 500; margin: 0 0 8px;">
                Step 3 of 3
            </p>
            <h1 class="wms-login-tagline">Choose warehouse</h1>
            <p style="font-size: 14px; opacity: 0.7; color: var(--wms-hero-text); margin: 0;">
                Pick the warehouse you'll be working from
            </p>
        </div>
    </aside>

    <main class="wms-login-form">
        <div class="wms-login-form-inner">
            <h2 class="wms-login-form-title">Select warehouse</h2>
            <p class="wms-login-form-subtitle">
                Choose the warehouse you'll be working from.
            </p>

            <div asp-validation-summary="ModelOnly" class="wms-error-msg mb-3"></div>

            <form asp-action="SelectWarehouse" method="post">
                @foreach (var w in Model.Warehouses)
                {
                    <button type="submit" name="SelectedWarehouseId" value="@w.Id"
                            class="wms-card wms-card-interactive"
                            style="display: flex; align-items: center; gap: 12px; width: 100%; margin-bottom: 8px; cursor: pointer; text-align: left;">
                        <div style="width: 44px; height: 44px; background: var(--wms-primary); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="ti ti-building-warehouse" style="font-size: 20px;"></i>
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <p class="wms-mono" style="font-size: 13px; font-weight: 500; margin: 0 0 2px; color: var(--wms-text-primary);">@w.Code</p>
                            <p class="wms-truncate" style="font-size: 11px; color: var(--wms-text-secondary); margin: 0;">@w.Name</p>
                        </div>
                        <i class="ti ti-chevron-right" style="font-size: 16px; color: var(--wms-text-tertiary); flex-shrink: 0;"></i>
                    </button>
                }
            </form>
        </div>
    </main>
</div>
