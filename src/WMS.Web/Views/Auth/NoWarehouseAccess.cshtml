@{
    ViewData["Title"] = "No warehouse access";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="alert alert-warning mt-5" role="alert">
            <h4 class="alert-heading">No warehouse access</h4>
            <p>
                Your tenant has no active warehouses configured. Contact
                an administrator to set one up before signing in again.
            </p>
            <hr />
            <p class="mb-0">
                <a asp-action="Login" class="btn btn-outline-secondary btn-sm">
                    Back to sign in
                </a>
            </p>
        </div>
    </div>
</div>
