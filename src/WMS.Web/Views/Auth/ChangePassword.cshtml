@model WMS.Web.Models.Auth.ForcedPasswordChangeViewModel
@{
    ViewData["Title"] = "Set a new password";
}

<div class="wms-login-page">
    <aside class="wms-login-hero">
        <div class="wms-login-hero-content">
            <div class="wms-login-logo">
                <div class="wms-login-logo-icon">
                    <i class="ti ti-shield-lock" style="font-size: 22px; color: white;"></i>
                </div>
                <span class="wms-login-logo-text">WMS</span>
            </div>

            <span class="wms-login-pill">
                <i class="ti ti-key" style="font-size: 12px;"></i>
                Secure first sign-in
            </span>

            <h1 class="wms-login-tagline">
                One last step — set your password
            </h1>
        </div>

        <div class="wms-login-stats">
            <div class="wms-login-stat">
                <p class="wms-login-stat-value">8+</p>
                <p class="wms-login-stat-label">Characters</p>
            </div>
            <div class="wms-login-stat">
                <p class="wms-login-stat-value">Aa</p>
                <p class="wms-login-stat-label">Mixed case</p>
            </div>
            <div class="wms-login-stat">
                <p class="wms-login-stat-value">0-9</p>
                <p class="wms-login-stat-label">≥1 digit</p>
            </div>
        </div>
    </aside>

    <main class="wms-login-form">
        <div class="wms-login-form-inner">
            <h2 class="wms-login-form-title">Set a new password</h2>
            <p class="wms-login-form-subtitle">
                @if (!string.IsNullOrEmpty(Model.UserEmail))
                {
                    <text>Welcome <strong>@Model.UserEmail</strong>. Your administrator set a temporary password for you — please choose a permanent one before continuing.</text>
                }
                else
                {
                    <text>Please choose a permanent password before continuing.</text>
                }
            </p>

            <form asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="wms-error-msg mb-3"></div>

                <div class="wms-login-field">
                    <label class="wms-label" asp-for="NewPassword">NEW PASSWORD</label>
                    <input asp-for="NewPassword"
                           type="password"
                           class="wms-input wms-login-form-input"
                           placeholder="••••••••"
                           autocomplete="new-password"
                           autofocus />
                    <span asp-validation-for="NewPassword" class="wms-error-msg"></span>
                </div>

                <div class="wms-login-field">
                    <label class="wms-label" asp-for="ConfirmPassword">CONFIRM PASSWORD</label>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="wms-input wms-login-form-input"
                           placeholder="••••••••"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="wms-error-msg"></span>
                </div>

                <ul class="wms-login-footer" style="margin-top: 8px; padding-left: 18px; font-size: 12px; color: var(--wms-text-secondary, #6B7280); list-style: disc;">
                    <li>At least 8 characters</li>
                    <li>Includes upper + lower case letters</li>
                    <li>Includes at least one digit</li>
                </ul>

                <button type="submit" class="wms-btn wms-btn-primary wms-login-submit wms-btn-block">
                    Set password &amp; continue
                    <i class="ti ti-arrow-right"></i>
                </button>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
