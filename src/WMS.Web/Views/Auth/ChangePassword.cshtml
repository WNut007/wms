@model WMS.Web.Models.Auth.ForcedPasswordChangeViewModel
@{
    ViewData["Title"] = "Set a new password";
}

<div class="wms-login-page">
    <aside class="wms-login-hero">
        <div class="wms-login-hero-content">
            <div class="wms-login-logo">
                <div class="wms-login-logo-icon">
                    <i class="ti ti-shield-lock" style="font-size: 22px; color: white;"></i>
                </div>
                <span class="wms-login-logo-text">WMS</span>
            </div>

            <span class="wms-login-pill">
                <i class="ti ti-key" style="font-size: 12px;"></i>
                Secure first sign-in
            </span>

            <h1 class="wms-login-tagline">
                One last step — set your password
            </h1>
        </div>

        <div class="wms-login-stats">
            <div class="wms-login-stat">
                <p class="wms-login-stat-value">8+</p>
                <p class="wms-login-stat-label">Characters</p>
            </div>
            <div class="wms-login-stat">
                <p class="wms-login-stat-value">Aa</p>
                <p class="wms-login-stat-label">Mixed case</p>
            </div>
            <div class="wms-login-stat">
                <p class="wms-login-stat-value">0-9</p>
                <p class="wms-login-stat-label">≥1 digit</p>
            </div>
        </div>
    </aside>

    <main class="wms-login-form">
        <div class="wms-login-form-inner">
            <h2 class="wms-login-form-title">Set a new password</h2>
            <p class="wms-login-form-subtitle">
                @if (!string.IsNullOrEmpty(Model.UserEmail))
                {
                    <text>Welcome <strong>@Model.UserEmail</strong>. Please choose a permanent password before continuing.</text>
                }
                else
                {
                    <text>Please choose a permanent password before continuing.</text>
                }
            </p>

            @* TD-117 State-1 banner — forced-change context. Always
               shown here because /Auth/ChangePassword is the in-flow
               forced surface (operator only reaches it via the
               P0 #4 flow). Voluntary changes go through
               /Account/ChangePassword instead. *@
            <div class="av-banner av-banner--warning">
                <i class="ti ti-shield-lock av-banner-icon"></i>
                <div class="av-banner-body">
                    <span class="av-banner-title">Password change required</span>
                    <span class="av-banner-subtitle">
                        Your account was bootstrapped with a temporary password.
                        Set a new one to continue.
                    </span>
                </div>
            </div>

            <form asp-action="ChangePassword" method="post" novalidate
                  data-av-form data-av-rules="length,upper,lower,digit" data-av-min-length="8">
                <div asp-validation-summary="ModelOnly" class="wms-error-msg mb-3"></div>

                <div class="wms-login-field av-field">
                    <label class="wms-label" asp-for="NewPassword">NEW PASSWORD</label>
                    <div class="av-input-wrap">
                        <input asp-for="NewPassword"
                               type="password"
                               class="wms-input wms-login-form-input"
                               placeholder="Type a strong password"
                               autocomplete="new-password"
                               autofocus
                               data-av-new />
                        <button type="button" class="av-input-toggle"
                                aria-label="Show password"
                                data-av-toggle data-av-toggle-target="#NewPassword">
                            <i class="ti ti-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="wms-error-msg"></span>

                    @* Strength bar — JS adds the av-strength--{level}
                       class on the wrapper based on rules-met count. *@
                    <div class="av-strength" data-av-strength>
                        <div class="av-strength-bar">
                            <div class="av-strength-segment"></div>
                            <div class="av-strength-segment"></div>
                            <div class="av-strength-segment"></div>
                            <div class="av-strength-segment"></div>
                        </div>
                        <div class="av-strength-label" data-av-strength-label></div>
                    </div>

                    @* Live rule checklist — rules start neutral (gray)
                       and flip to green/red as the user types. *@
                    <ul class="av-checklist">
                        <li class="av-rule" data-av-rule="length">
                            <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                            <span>At least 8 characters</span>
                            <span class="av-rule-count" data-av-count></span>
                        </li>
                        <li class="av-rule" data-av-rule="upper">
                            <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                            <span>Uppercase letter (A-Z)</span>
                        </li>
                        <li class="av-rule" data-av-rule="lower">
                            <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                            <span>Lowercase letter (a-z)</span>
                        </li>
                        <li class="av-rule" data-av-rule="digit">
                            <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                            <span>Number (0-9)</span>
                        </li>
                    </ul>
                </div>

                <div class="wms-login-field av-field">
                    <label class="wms-label" asp-for="ConfirmPassword">CONFIRM PASSWORD</label>
                    <div class="av-input-wrap">
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="wms-input wms-login-form-input"
                               placeholder="Type the password again"
                               autocomplete="new-password"
                               data-av-confirm />
                        <button type="button" class="av-input-toggle"
                                aria-label="Show password"
                                data-av-toggle data-av-toggle-target="#ConfirmPassword">
                            <i class="ti ti-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="wms-error-msg"></span>
                    <div class="av-field-msg" data-av-match-msg></div>
                </div>

                @* `disabled` is set by password-validator.js immediately
                   on init (form starts with empty fields => not ready).
                   Markup leaves it enabled so non-JS clients still get a
                   working submit; server-side PasswordPolicy validates
                   on POST either way. *@
                <button type="submit"
                        class="wms-btn wms-btn-primary wms-login-submit wms-btn-block"
                        data-av-submit>
                    <span class="av-submit-text">
                        Set password &amp; continue
                        <i class="ti ti-arrow-right"></i>
                    </span>
                    <span class="av-submit-loading">
                        <i class="ti ti-loader-2"></i>
                        Setting password...
                    </span>
                </button>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
