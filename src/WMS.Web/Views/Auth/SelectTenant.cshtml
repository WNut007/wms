@model WMS.Web.Models.Auth.TenantSelectViewModel
@{
    ViewData["Title"] = "Select tenant";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-5">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Select tenant</h3>
                <p class="text-muted text-center small mb-4">
                    You have access to multiple tenants. Choose which one to enter.
                </p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var err in ViewData.ModelState[""]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="SelectTenant" method="post">
                    <div class="list-group mb-3">
                        @foreach (var t in Model.Tenants)
                        {
                            <label class="list-group-item d-flex align-items-center">
                                <input type="radio" name="SelectedTenantId"
                                       value="@t.TenantId" class="form-check-input me-3" required />
                                <div>
                                    <div><strong>@t.TenantCode</strong></div>
                                    <div class="text-muted small">@t.TenantName</div>
                                </div>
                            </label>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Continue</button>
                </form>
            </div>
        </div>
    </div>
</div>
