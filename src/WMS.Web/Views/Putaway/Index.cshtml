@model IReadOnlyList<WMS.DAL.Repositories.Inventory.PutawayQueueRow>
@{
    ViewData["Title"] = "Putaway";

    var okMsg = ViewBag.PutawayMessage as string;
    var errMsg = ViewBag.PutawayError as string;
    var now = DateTime.UtcNow;
    var todayCount = Model.Count(r => (now - r.CreatedAt).TotalHours < 24);
    var agedCount = Model.Count(r => (now - r.CreatedAt).TotalHours >= 24);
}

@* Phase 20 — Mobile Putaway queue per design-system spec.
   Mirrors Phase 18 receive shape (chip filter row + card list). *@
<style>
    .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    .pw-page-pad { padding: 12px 14px 24px; }

    .pw-banner {
        padding: 8px 12px; border-radius: 8px;
        font-size: 12px; margin-bottom: 10px;
        display: flex; align-items: center; gap: 6px;
    }
    .pw-banner-ok { background: #E1F5EE; color: #0F6E56; }
    .pw-banner-err { background: #FCEBEB; color: #A32D2D; }

    .pw-header { margin-bottom: 12px; }
    .pw-title  { font-size: 18px; font-weight: 500; color: #1f2937; }
    .pw-subtitle { font-size: 11px; color: #6b7280; margin-top: 2px; }

    .pw-chip-row {
        display: flex; gap: 6px; overflow-x: auto;
        padding: 0 0 10px;
    }
    .pw-chip {
        display: inline-flex; align-items: center; gap: 4px;
        height: 26px; padding: 0 10px; border-radius: 100px;
        font-size: 11px; font-weight: 500;
        background: #ffffff; border: 0.5px solid #e5e7eb;
        color: #6b7280; white-space: nowrap; cursor: pointer;
        transition: background 120ms;
    }
    .pw-chip.is-active {
        background: #534AB7; border-color: #534AB7; color: #ffffff;
    }
    .pw-chip-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 16px; height: 14px; padding: 0 4px;
        border-radius: 100px; font-size: 9px;
        background: rgba(0, 0, 0, 0.06); color: inherit;
    }
    .pw-chip.is-active .pw-chip-count { background: rgba(255, 255, 255, 0.2); }

    .pw-card {
        display: block; text-decoration: none; color: inherit;
        background: #ffffff; border: 0.5px solid #e5e7eb;
        border-radius: 11px; padding: 11px 13px; margin-bottom: 8px;
    }
    .pw-card.is-aged { border-left: 3px solid #EF9F27; }
    .pw-card:active { background: #f9fafb; }

    .pw-row {
        display: flex; justify-content: space-between; align-items: flex-start;
    }
    .pw-product-code {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 12px; font-weight: 500; color: #1f2937;
    }
    .pw-product-name { font-size: 10px; color: #6b7280; margin-top: 2px; }
    .pw-stats { font-size: 10px; color: #6b7280; margin-top: 8px; }
    .pw-stats .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }

    .pw-aged-flag {
        display: inline-flex; align-items: center;
        font-size: 9px; font-weight: 500;
        padding: 1px 6px; border-radius: 100px;
        background: #FAEEDA; color: #854F0B;
    }

    .pw-empty {
        text-align: center; padding: 48px 16px;
        color: #9ca3af; font-size: 12px;
    }
    .pw-empty-icon { font-size: 32px; opacity: 0.4; }
</style>

<div class="pw-page-pad" x-data="putawayQueue()">
    @if (!string.IsNullOrEmpty(okMsg))
    {
        <div class="pw-banner pw-banner-ok">
            <i class="ti ti-check"></i> @okMsg
        </div>
    }
    @if (!string.IsNullOrEmpty(errMsg))
    {
        <div class="pw-banner pw-banner-err">
            <i class="ti ti-alert-circle"></i> @errMsg
        </div>
    }

    <div class="pw-header">
        <div class="pw-title">Putaway</div>
        <div class="pw-subtitle">@Model.Count item@(Model.Count == 1 ? "" : "s") awaiting putaway</div>
    </div>

    <div class="pw-chip-row no-scrollbar">
        <button type="button" class="pw-chip"
                :class="{ 'is-active': filter === 'all' }"
                @@click="filter = 'all'">
            All <span class="pw-chip-count">@Model.Count</span>
        </button>
        <button type="button" class="pw-chip"
                :class="{ 'is-active': filter === 'today' }"
                @@click="filter = 'today'">
            Today <span class="pw-chip-count">@todayCount</span>
        </button>
        <button type="button" class="pw-chip"
                :class="{ 'is-active': filter === 'aged' }"
                @@click="filter = 'aged'">
            Aged <span class="pw-chip-count">@agedCount</span>
        </button>
    </div>

    @if (Model.Count == 0)
    {
        <div class="pw-empty">
            <div class="pw-empty-icon"><i class="ti ti-package-off"></i></div>
            <p class="m-0 mt-2">No items awaiting putaway.</p>
            <p class="m-0 small">All caught up!</p>
        </div>
    }
    else
    {
        @foreach (var row in Model)
        {
            var hours = (now - row.CreatedAt).TotalHours;
            var isAged = hours >= 24;
            var bucket = isAged ? "aged" : "today";
            var waitLabel = hours < 1 ? $"{(int)(hours * 60)}m waiting"
                          : hours < 24 ? $"{(int)hours}h waiting"
                          : $"{(int)(hours / 24)}d waiting";
            <a href="/putaway/@row.StockId" class="pw-card @(isAged ? "is-aged" : "")"
               x-show="filter === 'all' || filter === '@bucket'">
                <div class="pw-row">
                    <div>
                        <div class="pw-product-code">@row.ProductCode</div>
                        <div class="pw-product-name">@row.ProductName · @row.QuantityOnHand.ToString("N0") @row.UomCode</div>
                    </div>
                    @if (isAged)
                    {
                        <span class="pw-aged-flag">Aged</span>
                    }
                </div>
                <div class="pw-stats">
                    <i class="ti ti-map-pin"></i> from <span class="mono">@row.LocationCode</span>
                    · <i class="ti ti-clock"></i> @waitLabel
                    @if (!string.IsNullOrEmpty(row.LotNumber))
                    {
                        <span> · <i class="ti ti-tag"></i> Lot @row.LotNumber</span>
                    }
                </div>
            </a>
        }
    }
</div>

@section Scripts {
    <script>
        function putawayQueue() {
            return { filter: 'all' };
        }
    </script>
}
