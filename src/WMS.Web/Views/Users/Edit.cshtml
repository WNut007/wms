@model WMS.Web.ViewModels.Security.UserEditViewModel
@{
    Layout = "_OfficeLayout";
    ViewData["Title"] = $"Edit · {Model.Email}";
    var roles = ViewBag.Roles as IReadOnlyList<WMS.Domain.Entities.Security.Role>
                ?? Array.Empty<WMS.Domain.Entities.Security.Role>();
}

<div class="wms-page-header">
    <div>
        <p class="wms-page-title">Edit user</p>
        <div class="wms-breadcrumb">
            <span>Security</span>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-action="Index" style="color: var(--wms-text-secondary);">Users</a>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-action="Detail" asp-route-id="@Model.Id" style="color: var(--wms-text-secondary);">@Model.Email</a>
            <span class="wms-breadcrumb-sep">/</span>
            <span class="wms-breadcrumb-current">Edit</span>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="rp-chart-card" style="max-width: 760px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="wms-banner wms-banner-danger"
         style="margin-bottom: 16px;"></div>

    <p class="rp-chart-title">Identity</p>
    <div class="rp-form-grid">
        <div>
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="wms-input" autocomplete="off" />
            <span asp-validation-for="Email" class="wms-field-error"></span>
        </div>
        <div>
            <label asp-for="FullName">Full name</label>
            <input asp-for="FullName" class="wms-input" autocomplete="off" />
            <span asp-validation-for="FullName" class="wms-field-error"></span>
        </div>
        <div>
            <label asp-for="ApprovalLimit">Approval limit (optional)</label>
            <input asp-for="ApprovalLimit" type="number" step="0.01" class="wms-input" />
            <span asp-validation-for="ApprovalLimit" class="wms-field-error"></span>
        </div>
        <div>
            <label style="visibility: hidden;">spacer</label>
            <p class="wms-field-hint" style="margin: 12px 0 0;">
                Password change is a Phase 25 feature. Use Unlock from Detail to clear lockout.
            </p>
        </div>
    </div>

    <p class="rp-chart-title" style="margin-top: 24px;">Roles</p>
    @if (roles.Count == 0)
    {
        <p class="rp-empty">No roles configured.</p>
    }
    else
    {
        <div class="rp-role-grid">
            @foreach (var role in roles)
            {
                var isChecked = Model.RoleIds.Contains(role.Id);
                <label class="rp-role-card">
                    <input type="checkbox" name="RoleIds" value="@role.Id" @(isChecked ? "checked" : "") />
                    <div>
                        <span class="rp-mono">@role.Code</span>
                        @if (role.IsSystemRole) { <span class="wms-badge s-info" style="font-size:10px; margin-left:6px;">System</span> }
                        <p style="margin: 2px 0 0; font-size: 12px; color: var(--wms-text-secondary);">@role.Name</p>
                    </div>
                </label>
            }
        </div>
    }

    <div style="display: flex; gap: 8px; margin-top: 24px;">
        <button type="submit" class="wms-btn wms-btn-purple">
            <i class="ti ti-device-floppy" aria-hidden="true"></i> Save changes
        </button>
        <a asp-action="Detail" asp-route-id="@Model.Id" class="wms-btn">Cancel</a>
    </div>
</form>

<style>
    .rp-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }
    @@media (max-width: 700px) {
        .rp-form-grid { grid-template-columns: 1fr; }
    }
    .rp-form-grid label,
    .rp-role-grid label {
        font-size: 12px;
        color: var(--wms-text-secondary);
        font-weight: 500;
        display: block;
        margin-bottom: 4px;
    }
    .wms-field-error {
        display: block;
        font-size: 12px;
        color: #DC2626;
        margin-top: 4px;
    }
    .wms-field-hint {
        font-size: 11px;
        color: var(--wms-text-tertiary);
        margin: 4px 0 0;
    }
    .rp-role-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 10px;
    }
    .rp-role-card {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        cursor: pointer;
        transition: 150ms ease;
    }
    .rp-role-card:hover {
        border-color: #534AB7;
        background: #FAFAFE;
    }
    .rp-role-card input[type=checkbox] {
        margin-top: 2px;
        width: 16px; height: 16px;
        accent-color: #534AB7;
        cursor: pointer;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
