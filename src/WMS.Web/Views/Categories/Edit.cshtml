@model WMS.Web.Models.Master.CategoryEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Code}";
    var parents = (ViewBag.Parents as IReadOnlyList<WMS.DAL.Repositories.Master.ProductCategoryPickerItem>)
        ?? Array.Empty<WMS.DAL.Repositories.Master.ProductCategoryPickerItem>();
    var statusVariant = Model.IsActive ? "s-success" : "s-neutral";
    var statusLabel = Model.IsActive ? "Active" : "Archived";
}

<form asp-action="Edit" asp-route-code="@Model.Code" method="post"
      class="wmsf-page" autocomplete="off">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Code" />
    <input type="hidden" asp-for="Path" />

    <nav class="wmsf-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Master Data</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <a asp-action="Index">Categories</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <span class="current">@Model.Code</span>
    </nav>

    <header class="wmsf-header">
        <div class="wmsf-header-title">
            <div class="wmsf-header-icon" aria-hidden="true"><i class="ti ti-category"></i></div>
            <div class="wmsf-header-text">
                <h1>@Model.Name</h1>
                <p style="font-family: var(--wms-font-mono);">@Model.Code · @(Model.Path ?? "/")</p>
            </div>
        </div>
        <div class="wmsf-header-status">
            <span class="wmsf-status-badge @statusVariant">@statusLabel</span>
        </div>
    </header>

    @if (ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="wmsf-form-error" role="alert">
            @foreach (var err in ViewData.ModelState[""]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <section class="wmsf-pane">
        <div class="wmsf-pane-head">
            <div>
                <p class="wmsf-pane-eyebrow">— Identity</p>
                <h2>Code, name, and parent</h2>
                <p class="wmsf-pane-desc">
                    Code is permanent. Name + parent + display order can be edited.
                    Path is maintained automatically when Name or parent changes.
                </p>
            </div>
        </div>

        <div class="wmsf-grid wmsf-grid-2">
            <div class="wmsf-field">
                <label class="wmsf-field-label">Code</label>
                <input class="wmsf-input" value="@Model.Code" readonly disabled />
                <span class="wmsf-helper">Code cannot be changed.</span>
            </div>
            <div class="wmsf-field">
                <label asp-for="Name" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.Name) <span class="req">*</span>
                </label>
                <input asp-for="Name" class="wmsf-input" />
                <span asp-validation-for="Name" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field col-span-2">
                <label asp-for="ParentId" class="wmsf-field-label">Parent</label>
                <select asp-for="ParentId" class="wmsf-input">
                    <option value="">(root — no parent)</option>
                    @foreach (var p in parents)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.ParentId)">
                            @(p.Path ?? "/" + p.Name) — @p.Code
                        </option>
                    }
                </select>
                <span asp-validation-for="ParentId" class="wmsf-error"></span>
                <span class="wmsf-helper">
                    Self + descendants are excluded from the dropdown to prevent cycles.
                    Path is recomputed automatically if parent changes.
                </span>
            </div>

            <div class="wmsf-field col-span-2">
                <label asp-for="Description" class="wmsf-field-label">@Html.DisplayNameFor(m => m.Description)</label>
                <textarea asp-for="Description" class="wmsf-textarea" rows="2"></textarea>
                <span asp-validation-for="Description" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="DisplayOrder" class="wmsf-field-label">@Html.DisplayNameFor(m => m.DisplayOrder)</label>
                <input asp-for="DisplayOrder" class="wmsf-input" type="number" min="0" max="9999" />
                <span asp-validation-for="DisplayOrder" class="wmsf-error"></span>
            </div>
            <div class="wmsf-field">
                <label class="wmsf-field-label">Active</label>
                <label class="wmsf-check-item">
                    <input asp-for="IsActive" type="checkbox" />
                    Available in dropdowns
                </label>
                <span class="wmsf-helper">Uncheck to archive — operators can no longer pick this category.</span>
            </div>
        </div>
    </section>

    <div class="wmsf-actions">
        <a asp-action="Index" class="wmsf-btn">
            <i class="ti ti-arrow-left" aria-hidden="true"></i> Back to list
        </a>
        <span class="wmsf-actions-info"></span>
        <button type="submit" class="wmsf-btn wmsf-btn-primary">
            <i class="ti ti-check" aria-hidden="true"></i> Save changes
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
