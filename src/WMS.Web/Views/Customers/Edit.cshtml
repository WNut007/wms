@model WMS.Web.Models.Master.CustomerEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Code}";

    var initials = string.Concat(
        Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => char.ToUpperInvariant(w[0])));

    var statusVariant = Model.Status switch
    {
        "Active"    => "s-success",
        "Suspended" => "s-warning",
        "Draft"     => "s-warning",
        _           => "s-neutral",
    };

    var hasS1Err = ViewData.ModelState["Name"]?.Errors.Count > 0;
    var hasS2Err = ViewData.ModelState["CompanyName"]?.Errors.Count > 0
        || ViewData.ModelState["TaxId"]?.Errors.Count > 0
        || ViewData.ModelState["Email"]?.Errors.Count > 0
        || ViewData.ModelState["Phone"]?.Errors.Count > 0
        || ViewData.ModelState["Country"]?.Errors.Count > 0;
    var hasS3Err = ViewData.ModelState["CustomerTier"]?.Errors.Count > 0
        || ViewData.ModelState["PromisedFillRate"]?.Errors.Count > 0;
    var hasS4Err = ViewData.ModelState["Status"]?.Errors.Count > 0;
    var initialStep = hasS1Err ? 1 : (hasS2Err ? 2 : (hasS3Err ? 3 : (hasS4Err ? 4 : 1)));

    // B2B-only required for the Contact section.
    var s2Required = Model.CustomerType == "B2B"
        ? "['CompanyName', 'TaxId']"
        : "[]";
}

<form asp-controller="Customers" asp-action="Edit" asp-route-code="@Model.Code"
      method="post"
      class="wmsf-page"
      autocomplete="off"
      x-data="wmsfFormState({
          mode: 'edit',
          totalSteps: 4,
          initialStep: @initialStep,
          serverErrors: {
              1: @(hasS1Err ? "true" : "false"),
              2: @(hasS2Err ? "true" : "false"),
              3: @(hasS3Err ? "true" : "false"),
              4: @(hasS4Err ? "true" : "false")
          },
          required: {
              1: ['Name'],
              2: @Html.Raw(s2Required),
              3: [],
              4: ['Status']
          }
      })">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Code" />
    <input type="hidden" asp-for="CustomerType" />

    <nav class="wmsf-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Master Data</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <a asp-controller="Customers" asp-action="Index">Customers</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <a asp-controller="Customers" asp-action="Detail" asp-route-code="@Model.Code">@Model.Code</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <span class="current">Edit</span>
    </nav>

    <header class="wmsf-header">
        <div class="wmsf-header-title">
            <div class="wmsf-header-icon" aria-hidden="true">@initials</div>
            <div class="wmsf-header-text">
                <h1>@Model.Name</h1>
                <p style="font-family: var(--wms-font-mono);">@Model.Code · @Model.CustomerType</p>
            </div>
        </div>
        <div class="wmsf-header-status">
            <span class="wmsf-status-badge @statusVariant">@Model.Status</span>
            <a asp-controller="Customers" asp-action="Detail" asp-route-code="@Model.Code"
               class="wmsf-btn">
                <i class="ti ti-external-link" aria-hidden="true"></i> View
            </a>
        </div>
    </header>

    @if (ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="wmsf-form-error" role="alert">
            @foreach (var err in ViewData.ModelState[""]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <ul class="wmsf-tabs" role="tablist">
        <li>
            <button type="button" class="wmsf-tab" :class="{ 'is-active': step === 1 }" @@click="goTo(1)" role="tab">
                <span class="wmsf-tab-num">1</span>
                <span class="wmsf-tab-text">
                    <span class="wmsf-tab-eyebrow">Section</span>
                    <span class="wmsf-tab-name">Identity</span>
                </span>
                <span class="wmsf-dot" :class="dotClass(1)" aria-hidden="true"></span>
            </button>
        </li>
        <li>
            <button type="button" class="wmsf-tab" :class="{ 'is-active': step === 2 }" @@click="goTo(2)" role="tab">
                <span class="wmsf-tab-num">2</span>
                <span class="wmsf-tab-text">
                    <span class="wmsf-tab-eyebrow">Section</span>
                    <span class="wmsf-tab-name">Contact</span>
                </span>
                <span class="wmsf-dot" :class="dotClass(2)" aria-hidden="true"></span>
            </button>
        </li>
        <li>
            <button type="button" class="wmsf-tab" :class="{ 'is-active': step === 3 }" @@click="goTo(3)" role="tab">
                <span class="wmsf-tab-num">3</span>
                <span class="wmsf-tab-text">
                    <span class="wmsf-tab-eyebrow">Section</span>
                    <span class="wmsf-tab-name">Commercial</span>
                </span>
                <span class="wmsf-dot" :class="dotClass(3)" aria-hidden="true"></span>
            </button>
        </li>
        <li>
            <button type="button" class="wmsf-tab" :class="{ 'is-active': step === 4 }" @@click="goTo(4)" role="tab">
                <span class="wmsf-tab-num">4</span>
                <span class="wmsf-tab-text">
                    <span class="wmsf-tab-eyebrow">Section</span>
                    <span class="wmsf-tab-name">Status</span>
                </span>
                <span class="wmsf-dot" :class="dotClass(4)" aria-hidden="true"></span>
            </button>
        </li>
    </ul>

    @* === Pane 1 — Identity === *@
    <section class="wmsf-pane" x-show="step === 1" x-cloak role="tabpanel">
        <div class="wmsf-pane-head">
            <div>
                <p class="wmsf-pane-eyebrow">— Section 01</p>
                <h2>Identity</h2>
                <p class="wmsf-pane-desc">Code and customer type are permanent on Edit.</p>
            </div>
        </div>

        <div class="wmsf-grid wmsf-grid-2">
            <div class="wmsf-field">
                <label class="wmsf-field-label">Code</label>
                <input class="wmsf-input" value="@Model.Code" readonly disabled />
                <span class="wmsf-helper">Code cannot be changed.</span>
            </div>

            <div class="wmsf-field">
                <label class="wmsf-field-label">Customer type</label>
                <input class="wmsf-input" value="@Model.CustomerType" readonly disabled />
                <span class="wmsf-helper">Type cannot change post-creation.</span>
            </div>

            <div class="wmsf-field col-span-2">
                <label asp-for="Name" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.Name) <span class="req">*</span>
                </label>
                <input asp-for="Name" class="wmsf-input" @@input="onTouch('Name')" />
                <span asp-validation-for="Name" class="wmsf-error"></span>
            </div>
        </div>
    </section>

    @* === Pane 2 — Contact === *@
    <section class="wmsf-pane" x-show="step === 2" x-cloak role="tabpanel">
        <div class="wmsf-pane-head">
            <div>
                <p class="wmsf-pane-eyebrow">— Section 02</p>
                <h2>Contact</h2>
                <p class="wmsf-pane-desc">Reach details. @(Model.CustomerType == "B2B" ? "Company name + Tax ID required for B2B." : "B2C — legal-entity fields optional.")</p>
            </div>
        </div>

        <div class="wmsf-grid wmsf-grid-2">
            <div class="wmsf-field">
                <label asp-for="CompanyName" class="wmsf-field-label">
                    Company name
                    @if (Model.CustomerType == "B2B")
                    {
                        <span class="req">*</span>
                    }
                </label>
                <input asp-for="CompanyName" class="wmsf-input" @@input="onTouch('CompanyName')" />
                <span asp-validation-for="CompanyName" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="TaxId" class="wmsf-field-label">
                    Tax ID
                    @if (Model.CustomerType == "B2B")
                    {
                        <span class="req">*</span>
                    }
                </label>
                <input asp-for="TaxId" class="wmsf-input" @@input="onTouch('TaxId')" />
                <span asp-validation-for="TaxId" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="Email" class="wmsf-field-label">@Html.DisplayNameFor(m => m.Email)</label>
                <input asp-for="Email" type="email" class="wmsf-input" @@input="onTouch('Email')" />
                <span asp-validation-for="Email" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="Phone" class="wmsf-field-label">@Html.DisplayNameFor(m => m.Phone)</label>
                <input asp-for="Phone" class="wmsf-input" @@input="onTouch('Phone')" />
                <span asp-validation-for="Phone" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field col-span-2">
                <label asp-for="Country" class="wmsf-field-label">@Html.DisplayNameFor(m => m.Country)</label>
                <input asp-for="Country" class="wmsf-input" @@input="onTouch('Country')" />
                <span asp-validation-for="Country" class="wmsf-error"></span>
            </div>
        </div>
    </section>

    @* === Pane 3 — Commercial === *@
    <section class="wmsf-pane" x-show="step === 3" x-cloak role="tabpanel">
        <div class="wmsf-pane-head">
            <div>
                <p class="wmsf-pane-eyebrow">— Section 03</p>
                <h2>Commercial</h2>
                <p class="wmsf-pane-desc">Tier, allocation priority, fill rate, and carrier preference.</p>
            </div>
        </div>

        <div class="wmsf-grid wmsf-grid-3">
            <div class="wmsf-field">
                <label asp-for="CustomerTier" class="wmsf-field-label">@Html.DisplayNameFor(m => m.CustomerTier)</label>
                <select asp-for="CustomerTier" class="wmsf-select" @@change="onTouch('CustomerTier')">
                    <option value="">— None —</option>
                    @foreach (var t in WMS.Web.Models.Master.CustomerEditViewModel.AllTiers)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="CustomerTier" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="AnnualRevenue" class="wmsf-field-label">@Html.DisplayNameFor(m => m.AnnualRevenue)</label>
                <input asp-for="AnnualRevenue" type="number" step="0.01" class="wmsf-input" @@input="onTouch('AnnualRevenue')" />
            </div>

            <div class="wmsf-field">
                <label asp-for="OrdersPerMonth" class="wmsf-field-label">@Html.DisplayNameFor(m => m.OrdersPerMonth)</label>
                <input asp-for="OrdersPerMonth" type="number" class="wmsf-input" @@input="onTouch('OrdersPerMonth')" />
            </div>

            <div class="wmsf-field">
                <label asp-for="AvgOrderValue" class="wmsf-field-label">@Html.DisplayNameFor(m => m.AvgOrderValue)</label>
                <input asp-for="AvgOrderValue" type="number" step="0.01" class="wmsf-input" @@input="onTouch('AvgOrderValue')" />
            </div>

            <div class="wmsf-field">
                <label asp-for="AllocationPriority" class="wmsf-field-label">@Html.DisplayNameFor(m => m.AllocationPriority)</label>
                <input asp-for="AllocationPriority" type="number" class="wmsf-input" @@input="onTouch('AllocationPriority')" />
            </div>

            <div class="wmsf-field">
                <label asp-for="SafetyStockDays" class="wmsf-field-label">@Html.DisplayNameFor(m => m.SafetyStockDays)</label>
                <input asp-for="SafetyStockDays" type="number" class="wmsf-input" @@input="onTouch('SafetyStockDays')" />
            </div>

            <div class="wmsf-field">
                <label asp-for="PromisedFillRate" class="wmsf-field-label">@Html.DisplayNameFor(m => m.PromisedFillRate)</label>
                <input asp-for="PromisedFillRate" type="number" step="0.01" min="0" max="100" class="wmsf-input" @@input="onTouch('PromisedFillRate')" />
                <span asp-validation-for="PromisedFillRate" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="PreferredCarrierId" class="wmsf-field-label">@Html.DisplayNameFor(m => m.PreferredCarrierId)</label>
                <select asp-for="PreferredCarrierId" class="wmsf-select" @@change="onTouch('PreferredCarrierId')">
                    <option value="">— None —</option>
                    @foreach (var c in Model.Carriers)
                    {
                        <option value="@c.Id">@c.Code · @c.Name</option>
                    }
                </select>
            </div>

            <div class="wmsf-field">
                <label asp-for="DefaultPaymentTerms" class="wmsf-field-label">@Html.DisplayNameFor(m => m.DefaultPaymentTerms)</label>
                <input asp-for="DefaultPaymentTerms" class="wmsf-input" @@input="onTouch('DefaultPaymentTerms')" />
            </div>

            <div class="wmsf-field col-span-3" style="display: flex; gap: 24px; flex-wrap: wrap;">
                <label class="wmsf-check-item">
                    <input asp-for="IsKeyAccount" type="checkbox" />
                    Key account
                </label>
                <label class="wmsf-check-item">
                    <input asp-for="IsStrategic" type="checkbox" />
                    Strategic
                </label>
            </div>
        </div>
    </section>

    @* === Pane 4 — Status === *@
    <section class="wmsf-pane" x-show="step === 4" x-cloak role="tabpanel">
        <div class="wmsf-pane-head">
            <div>
                <p class="wmsf-pane-eyebrow">— Section 04</p>
                <h2>Status</h2>
                <p class="wmsf-pane-desc">Toggle Inactive to archive. Suspended for credit holds.</p>
            </div>
        </div>

        <div class="wmsf-grid">
            <div class="wmsf-field" style="max-width: 320px;">
                <label asp-for="Status" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.Status) <span class="req">*</span>
                </label>
                <select asp-for="Status" class="wmsf-select" @@change="onTouch('Status')">
                    @foreach (var s in WMS.Web.Models.Master.CustomerEditViewModel.AllStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <span asp-validation-for="Status" class="wmsf-error"></span>
            </div>
        </div>
    </section>

    <div class="wmsf-actions">
        <a asp-controller="Customers" asp-action="Detail" asp-route-code="@Model.Code" class="wmsf-btn">
            <i class="ti ti-x" aria-hidden="true"></i> Cancel
        </a>
        <span class="wmsf-actions-info">
            <span x-show="!Object.keys(touched).length">No unsaved changes</span>
            <span x-show="Object.keys(touched).length" style="color: var(--wmsf-warning-fg);">
                Unsaved changes
            </span>
        </span>
        <button type="submit" class="wmsf-btn wmsf-btn-primary">
            <i class="ti ti-check" aria-hidden="true"></i> Save changes
        </button>
    </div>
</form>

<style>[x-cloak] { display: none !important; }</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/wmsf-form-state.js" asp-append-version="true"></script>
}
