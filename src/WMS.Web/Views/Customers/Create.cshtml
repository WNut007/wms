@model WMS.Web.Models.Master.CustomerCreateViewModel
@{
    ViewData["Title"] = "New customer";
}

@*
    Phase 7D Customer Create — 4-step Alpine stepper. Largest of the
    three forms (18 fields). CompanyName + TaxId are conditionally
    REQUIRED when CustomerType='B2B'; the FluentValidation rule on the
    server is authoritative — the view just hints by appending
    "(required for B2B)" via x-text when relevant.
*@

<div class="wms-page-header">
    <div>
        <p class="wms-page-title">New customer</p>
        <div class="wms-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Master Data</a>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-controller="Customers" asp-action="Index">Customers</a>
            <span class="wms-breadcrumb-sep">/</span>
            <span class="wms-breadcrumb-current">New</span>
        </div>
    </div>
</div>

<form asp-controller="Customers" asp-action="Create" method="post"
      x-data="{ step: 1, customerType: '@Model.CustomerType' }" autocomplete="off">

    @if (ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="alert alert-danger mb-3" role="alert">
            @foreach (var err in ViewData.ModelState[""]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <ul class="steps steps-counter mb-4">
        <li class="step-item" :class="{ 'active': step >= 1 }" @@click="step = 1" style="cursor: pointer;">Identity</li>
        <li class="step-item" :class="{ 'active': step >= 2 }" @@click="step = 2" style="cursor: pointer;">Contact</li>
        <li class="step-item" :class="{ 'active': step >= 3 }" @@click="step = 3" style="cursor: pointer;">Commercial</li>
        <li class="step-item" :class="{ 'active': step >= 4 }" @@click="step = 4" style="cursor: pointer;">Status</li>
    </ul>

    @* Step 1 — Identity *@
    <div class="wms-card mb-3" x-show="step === 1" x-cloak>
        <h6 class="mb-3">Identity</h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" autofocus />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="CustomerType" class="form-label"></label>
                <div>
                    @foreach (var ct in WMS.Web.Models.Master.CustomerCreateViewModel.AllCustomerTypes)
                    {
                        <div class="form-check form-check-inline">
                            <input asp-for="CustomerType" type="radio" value="@ct" id="ct-@ct"
                                   class="form-check-input" x-model="customerType" />
                            <label for="ct-@ct" class="form-check-label">@ct</label>
                        </div>
                    }
                </div>
                <span asp-validation-for="CustomerType" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button type="button" class="btn btn-primary" @@click="step = 2">Next →</button>
        </div>
    </div>

    @* Step 2 — Contact *@
    <div class="wms-card mb-3" x-show="step === 2" x-cloak>
        <h6 class="mb-3">Contact</h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label">
                    Company name
                    <small class="text-muted" x-show="customerType === 'B2B'">(required for B2B)</small>
                </label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TaxId" class="form-label">
                    Tax ID
                    <small class="text-muted" x-show="customerType === 'B2B'">(required for B2B)</small>
                </label>
                <input asp-for="TaxId" class="form-control" />
                <span asp-validation-for="TaxId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Country" class="form-label"></label>
                <input asp-for="Country" class="form-control" />
                <span asp-validation-for="Country" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <button type="button" class="btn btn-outline-secondary" @@click="step = 1">← Back</button>
            <button type="button" class="btn btn-primary" @@click="step = 3">Next →</button>
        </div>
    </div>

    @* Step 3 — Commercial *@
    <div class="wms-card mb-3" x-show="step === 3" x-cloak>
        <h6 class="mb-3">Commercial</h6>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CustomerTier" class="form-label"></label>
                <select asp-for="CustomerTier" class="form-select">
                    <option value="">— None —</option>
                    @foreach (var t in WMS.Web.Models.Master.CustomerCreateViewModel.AllTiers)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="CustomerTier" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="AnnualRevenue" class="form-label"></label>
                <input asp-for="AnnualRevenue" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="AnnualRevenue" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="OrdersPerMonth" class="form-label"></label>
                <input asp-for="OrdersPerMonth" type="number" class="form-control" />
                <span asp-validation-for="OrdersPerMonth" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="AvgOrderValue" class="form-label"></label>
                <input asp-for="AvgOrderValue" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="AvgOrderValue" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="AllocationPriority" class="form-label"></label>
                <input asp-for="AllocationPriority" type="number" class="form-control" />
                <span asp-validation-for="AllocationPriority" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="SafetyStockDays" class="form-label"></label>
                <input asp-for="SafetyStockDays" type="number" class="form-control" />
                <span asp-validation-for="SafetyStockDays" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="PromisedFillRate" class="form-label"></label>
                <input asp-for="PromisedFillRate" type="number" step="0.01" min="0" max="100" class="form-control" />
                <span asp-validation-for="PromisedFillRate" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="PreferredCarrierId" class="form-label"></label>
                <select asp-for="PreferredCarrierId" class="form-select">
                    <option value="">— None —</option>
                    @foreach (var c in Model.Carriers)
                    {
                        <option value="@c.Id">@c.Code · @c.Name</option>
                    }
                </select>
                <span asp-validation-for="PreferredCarrierId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="DefaultPaymentTerms" class="form-label"></label>
                <input asp-for="DefaultPaymentTerms" class="form-control" placeholder="Net 30, COD, ..." />
                <span asp-validation-for="DefaultPaymentTerms" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input asp-for="IsKeyAccount" class="form-check-input" />
                    <label asp-for="IsKeyAccount" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input asp-for="IsStrategic" class="form-check-input" />
                    <label asp-for="IsStrategic" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <button type="button" class="btn btn-outline-secondary" @@click="step = 2">← Back</button>
            <button type="button" class="btn btn-primary" @@click="step = 4">Next →</button>
        </div>
    </div>

    @* Step 4 — Status *@
    <div class="wms-card mb-3" x-show="step === 4" x-cloak>
        <h6 class="mb-3">Status</h6>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                @foreach (var s in WMS.Web.Models.Master.CustomerCreateViewModel.AllStatuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
            <span asp-validation-for="Status" class="text-danger small"></span>
            <small class="text-muted d-block mt-1">
                Draft customers are saved but excluded from active flows. Suspended is for credit holds.
            </small>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <button type="button" class="btn btn-outline-secondary" @@click="step = 3">← Back</button>
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-check me-1"></i> Create customer
            </button>
        </div>
    </div>
</form>

<style>
    [x-cloak] { display: none !important; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
