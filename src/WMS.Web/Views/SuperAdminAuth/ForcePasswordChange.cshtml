@model WMS.Web.ViewModels.SuperAdmin.SuperAdminForcedPwChangeViewModel
@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Set a new password";
}

@* _SuperAdminLayout hides the nav block when User.Identity.IsAuthenticated is false.
   For the forced-change step we deliberately don't SignInAsync — so the nav stays
   hidden + operator cannot navigate elsewhere. Same layout, no chrome. *@

<div style="max-width: 480px; margin: 60px auto;">
    <div class="sa-card">
        <h1 class="sa-title">
            <i class="ti ti-shield-lock" style="color: #DC2626; margin-right: 6px;"></i>
            One last step
        </h1>
        <p class="sa-subtitle">
            Your account was bootstrapped with a temporary password.
            Choose a permanent one to continue.
        </p>

        <div asp-validation-summary="ModelOnly" class="sa-banner-err" style="display: none;"></div>
        @if (!ViewData.ModelState.IsValid)
        {
            var summary = ViewData.ModelState[""]?.Errors.Select(e => e.ErrorMessage).ToList();
            if (summary is { Count: > 0 })
            {
                <div class="sa-banner-err">@string.Join("; ", summary)</div>
            }
        }

        <form asp-action="ForcePasswordChange" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 14px;">
                <label class="sa-label" asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" type="password" class="sa-input"
                       autocomplete="new-password" autofocus />
                <span asp-validation-for="NewPassword" class="sa-field-error"></span>
            </div>
            <div style="margin-bottom: 14px;">
                <label class="sa-label" asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" class="sa-input"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="sa-field-error"></span>
            </div>

            <ul style="margin: 0 0 16px 0; padding-left: 18px; font-size: 12px; color: #CBD5E1; list-style: disc;">
                <li>At least 8 characters</li>
                <li>Includes upper + lower case letters</li>
                <li>Includes at least one digit</li>
            </ul>

            <button type="submit" class="sa-btn" style="width: 100%; justify-content: center;">
                Set password &amp; continue
                <i class="ti ti-arrow-right"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
