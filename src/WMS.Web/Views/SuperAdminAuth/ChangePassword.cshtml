@model WMS.Web.ViewModels.SuperAdmin.SuperAdminChangePasswordViewModel
@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Change password";
    var mustChange = User.FindFirst("MustChangePassword")?.Value == "true";
}

<div style="max-width: 520px; margin: 24px auto;">
    @if (mustChange)
    {
        <div class="sa-warn-banner">
            <i class="ti ti-shield-exclamation"></i>
            <strong>Password change required.</strong> Your account was bootstrapped with a temporary password. Set a new one before continuing.
        </div>
    }

    @if (TempData["SuperAdminMessage"] is string okMsg)
    {
        <div class="sa-banner-ok">@okMsg</div>
    }

    <div class="sa-card">
        <h1 class="sa-title">Change password</h1>
        <p class="sa-subtitle">
            Minimum 8 characters, mixed case, ≥1 digit. Change clears any active lockout.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            var summary = ViewData.ModelState[""]?.Errors.Select(e => e.ErrorMessage).ToList();
            if (summary is { Count: > 0 })
            {
                <div class="sa-banner-err">@string.Join("; ", summary)</div>
            }
        }

        @* TD-117 — av-theme--dark switches the validator's color
           tokens for the slate-900 SuperAdmin shell. Same primitives
           as the Auth + Office surfaces; the namespace ensures no
           collision with the sa-* classes that drive the rest of the
           SuperAdmin look. *@
        <form asp-action="ChangePassword" method="post"
              class="av-theme--dark"
              data-av-form data-av-rules="length,upper,lower,digit" data-av-min-length="8">
            @Html.AntiForgeryToken()

            <div class="av-field" style="margin-bottom: 14px;">
                <label class="sa-label" asp-for="CurrentPassword"></label>
                <div class="av-input-wrap">
                    <input asp-for="CurrentPassword" type="password"
                           class="sa-input" autocomplete="current-password" />
                    <button type="button" class="av-input-toggle"
                            aria-label="Show password"
                            data-av-toggle data-av-toggle-target="#CurrentPassword">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="sa-field-error"></span>
            </div>

            <div class="av-field" style="margin-bottom: 14px;">
                <label class="sa-label" asp-for="NewPassword"></label>
                <div class="av-input-wrap">
                    <input asp-for="NewPassword" type="password"
                           class="sa-input" autocomplete="new-password" data-av-new />
                    <button type="button" class="av-input-toggle"
                            aria-label="Show password"
                            data-av-toggle data-av-toggle-target="#NewPassword">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="sa-field-error"></span>

                <div class="av-strength" data-av-strength>
                    <div class="av-strength-bar">
                        <div class="av-strength-segment"></div>
                        <div class="av-strength-segment"></div>
                        <div class="av-strength-segment"></div>
                        <div class="av-strength-segment"></div>
                    </div>
                    <div class="av-strength-label" data-av-strength-label></div>
                </div>

                <ul class="av-checklist">
                    <li class="av-rule" data-av-rule="length">
                        <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                        <span>At least 8 characters</span>
                        <span class="av-rule-count" data-av-count></span>
                    </li>
                    <li class="av-rule" data-av-rule="upper">
                        <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                        <span>Uppercase letter (A-Z)</span>
                    </li>
                    <li class="av-rule" data-av-rule="lower">
                        <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                        <span>Lowercase letter (a-z)</span>
                    </li>
                    <li class="av-rule" data-av-rule="digit">
                        <span class="av-rule-icon"><i class="ti ti-circle"></i></span>
                        <span>Number (0-9)</span>
                    </li>
                </ul>
            </div>

            <div class="av-field" style="margin-bottom: 18px;">
                <label class="sa-label" asp-for="ConfirmPassword"></label>
                <div class="av-input-wrap">
                    <input asp-for="ConfirmPassword" type="password"
                           class="sa-input" autocomplete="new-password" data-av-confirm />
                    <button type="button" class="av-input-toggle"
                            aria-label="Show password"
                            data-av-toggle data-av-toggle-target="#ConfirmPassword">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="sa-field-error"></span>
                <div class="av-field-msg" data-av-match-msg></div>
            </div>

            <div style="display: flex; gap: 8px;">
                <button type="submit" class="sa-btn" data-av-submit>
                    <span class="av-submit-text">
                        <i class="ti ti-lock"></i> Change password
                    </span>
                    <span class="av-submit-loading">
                        <i class="ti ti-loader-2"></i>
                        Changing password...
                    </span>
                </button>
                @if (!mustChange)
                {
                    <a href="/SuperAdmin/Dashboard" class="sa-btn sa-btn-secondary">Cancel</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
