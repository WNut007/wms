@model WMS.Web.Models.Master.ProductCreateViewModel
@{
    ViewData["Title"] = "New product";
}

@*
    Phase 7D Product Create — 2-step Alpine stepper.

    Stepper state: x-data="{ step: 1 }" on the form. Tabler-style steps
    nav at the top reflects current step. Hidden sections use Alpine
    x-show. Submit is only meaningful on the final step (UX hint via
    button placement); the form posts the full VM regardless of step
    visibility, so client-side ModelState validation runs across all
    fields.
*@

<div class="wms-page-header">
    <div>
        <p class="wms-page-title">New product</p>
        <div class="wms-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Master Data</a>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-controller="Products" asp-action="Index">Products</a>
            <span class="wms-breadcrumb-sep">/</span>
            <span class="wms-breadcrumb-current">New</span>
        </div>
    </div>
</div>

<form asp-controller="Products" asp-action="Create" method="post"
      x-data="{ step: 1, totalSteps: 2 }" autocomplete="off">

    @* Form-level errors (e.g. SqlException 547 catch-all) *@
    @if (ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="alert alert-danger mb-3" role="alert">
            @foreach (var err in ViewData.ModelState[""]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    @* Stepper nav *@
    <ul class="steps steps-counter mb-4">
        <li class="step-item"
            :class="{ 'active': step >= 1 }"
            @@click="step = 1"
            style="cursor: pointer;">Identity</li>
        <li class="step-item"
            :class="{ 'active': step >= 2 }"
            @@click="step = 2"
            style="cursor: pointer;">Classification</li>
    </ul>

    @* Step 1: Identity *@
    <div class="wms-card mb-3" x-show="step === 1" x-cloak>
        <h6 class="mb-3">Identity</h6>

        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" autofocus />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Brand" class="form-label"></label>
            <input asp-for="Brand" class="form-control" />
            <span asp-validation-for="Brand" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button type="button" class="btn btn-primary"
                    @@click="step = 2">Next →</button>
        </div>
    </div>

    @* Step 2: Classification *@
    <div class="wms-card mb-3" x-show="step === 2" x-cloak>
        <h6 class="mb-3">Classification</h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">— Select category —</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@c.Code · @c.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="BaseUomId" class="form-label"></label>
                <select asp-for="BaseUomId" class="form-select">
                    <option value="">— Select unit —</option>
                    @foreach (var u in Model.BaseUoms)
                    {
                        <option value="@u.Id">@u.Code · @u.Name</option>
                    }
                </select>
                <span asp-validation-for="BaseUomId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TrackingMethod" class="form-label"></label>
                <select asp-for="TrackingMethod" class="form-select">
                    @foreach (var tm in WMS.Web.Models.Master.ProductCreateViewModel.AllTrackingMethods)
                    {
                        <option value="@tm">@tm</option>
                    }
                </select>
                <span asp-validation-for="TrackingMethod" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    @foreach (var s in WMS.Web.Models.Master.ProductCreateViewModel.AllStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="VelocityClass" class="form-label"></label>
                <input asp-for="VelocityClass" class="form-control" placeholder="A / B / C" />
                <span asp-validation-for="VelocityClass" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4 pt-2">
                    <input asp-for="UseCatchWeight" class="form-check-input" />
                    <label asp-for="UseCatchWeight" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="button" class="btn btn-outline-secondary"
                    @@click="step = 1">← Back</button>
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-check me-1"></i> Create product
            </button>
        </div>
    </div>
</form>

<style>
    [x-cloak] { display: none !important; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
