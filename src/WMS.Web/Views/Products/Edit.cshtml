@model WMS.Web.Models.Master.ProductEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Code}";
}

@*
    Phase 7D Product Edit — single-page (no stepper). Code rendered as
    readonly + hidden field so it round-trips via the route param;
    UpdateAsync omits Code from SET regardless.
*@

<div class="wms-page-header">
    <div>
        <p class="wms-page-title">Edit @Model.Name</p>
        <div class="wms-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Master Data</a>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-controller="Products" asp-action="Index">Products</a>
            <span class="wms-breadcrumb-sep">/</span>
            <a asp-controller="Products" asp-action="Detail" asp-route-sku="@Model.Code">@Model.Code</a>
            <span class="wms-breadcrumb-sep">/</span>
            <span class="wms-breadcrumb-current">Edit</span>
        </div>
    </div>
</div>

<form asp-controller="Products" asp-action="Edit" asp-route-code="@Model.Code"
      method="post" autocomplete="off">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Code" />

    @if (ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="alert alert-danger mb-3" role="alert">
            @foreach (var err in ViewData.ModelState[""]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div class="wms-card mb-3">
        <h6 class="mb-3">Identity</h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Code</label>
                <input class="form-control" value="@Model.Code" readonly disabled />
                <small class="text-muted">SKU is permanent — create a new product if a different code is needed.</small>
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
                <span asp-validation-for="Brand" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="wms-card mb-3">
        <h6 class="mb-3">Classification</h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">— Select category —</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@c.Code · @c.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="BaseUomId" class="form-label"></label>
                <select asp-for="BaseUomId" class="form-select">
                    <option value="">— Select unit —</option>
                    @foreach (var u in Model.BaseUoms)
                    {
                        <option value="@u.Id">@u.Code · @u.Name</option>
                    }
                </select>
                <span asp-validation-for="BaseUomId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TrackingMethod" class="form-label"></label>
                <select asp-for="TrackingMethod" class="form-select">
                    @foreach (var tm in WMS.Web.Models.Master.ProductEditViewModel.AllTrackingMethods)
                    {
                        <option value="@tm">@tm</option>
                    }
                </select>
                <span asp-validation-for="TrackingMethod" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    @foreach (var s in WMS.Web.Models.Master.ProductEditViewModel.AllStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="VelocityClass" class="form-label"></label>
                <input asp-for="VelocityClass" class="form-control" placeholder="A / B / C" />
                <span asp-validation-for="VelocityClass" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4 pt-2">
                    <input asp-for="UseCatchWeight" class="form-check-input" />
                    <label asp-for="UseCatchWeight" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-controller="Products" asp-action="Detail" asp-route-sku="@Model.Code"
           class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-check me-1"></i> Save changes
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
