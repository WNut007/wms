@model WMS.Web.Models.Master.ProductEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Code}";

    // Avatar initials — first chars of up to 2 words.
    var initials = string.Concat(
        Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => char.ToUpperInvariant(w[0])));

    var statusVariant = Model.Status switch
    {
        "Active"       => "s-success",
        "Discontinued" => "s-danger",
        "Draft"        => "s-warning",
        _              => "s-neutral",
    };

    var hasS1Err = ViewData.ModelState["Name"]?.Errors.Count > 0
        || ViewData.ModelState["Brand"]?.Errors.Count > 0;
    var hasS2Err = ViewData.ModelState["CategoryId"]?.Errors.Count > 0
        || ViewData.ModelState["BaseUomId"]?.Errors.Count > 0
        || ViewData.ModelState["TrackingMethod"]?.Errors.Count > 0
        || ViewData.ModelState["Status"]?.Errors.Count > 0
        || ViewData.ModelState["VelocityClass"]?.Errors.Count > 0;
    var initialStep = hasS1Err ? 1 : (hasS2Err ? 2 : 1);
}

<form asp-controller="Products" asp-action="Edit" asp-route-code="@Model.Code"
      method="post"
      class="wmsf-page"
      autocomplete="off"
      x-data="wmsfFormState({
          mode: 'edit',
          totalSteps: 2,
          initialStep: @initialStep,
          serverErrors: {
              1: @(hasS1Err ? "true" : "false"),
              2: @(hasS2Err ? "true" : "false")
          },
          required: {
              1: ['Name'],
              2: ['CategoryId', 'BaseUomId', 'TrackingMethod', 'Status']
          }
      })">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Code" />

    <nav class="wmsf-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Master Data</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <a asp-controller="Products" asp-action="Index">Products</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <a asp-controller="Products" asp-action="Detail" asp-route-sku="@Model.Code">@Model.Code</a>
        <i class="ti ti-chevron-right sep" aria-hidden="true"></i>
        <span class="current">Edit</span>
    </nav>

    <header class="wmsf-header">
        <div class="wmsf-header-title">
            <div class="wmsf-header-icon" aria-hidden="true">@initials</div>
            <div class="wmsf-header-text">
                <h1>@Model.Name</h1>
                <p style="font-family: var(--wms-font-mono);">@Model.Code · Product</p>
            </div>
        </div>
        <div class="wmsf-header-status">
            <span class="wmsf-status-badge @statusVariant">@Model.Status</span>
            <a asp-controller="Products" asp-action="Detail" asp-route-sku="@Model.Code"
               class="wmsf-btn" title="View Detail">
                <i class="ti ti-external-link" aria-hidden="true"></i> View
            </a>
        </div>
    </header>

    @if (ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="wmsf-form-error" role="alert">
            @foreach (var err in ViewData.ModelState[""]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <ul class="wmsf-tabs" role="tablist">
        <li>
            <button type="button" class="wmsf-tab" :class="{ 'is-active': step === 1 }" @@click="goTo(1)" role="tab">
                <span class="wmsf-tab-num">1</span>
                <span class="wmsf-tab-text">
                    <span class="wmsf-tab-eyebrow">Section</span>
                    <span class="wmsf-tab-name">Identity</span>
                </span>
                <span class="wmsf-dot" :class="dotClass(1)" aria-hidden="true"></span>
            </button>
        </li>
        <li>
            <button type="button" class="wmsf-tab" :class="{ 'is-active': step === 2 }" @@click="goTo(2)" role="tab">
                <span class="wmsf-tab-num">2</span>
                <span class="wmsf-tab-text">
                    <span class="wmsf-tab-eyebrow">Section</span>
                    <span class="wmsf-tab-name">Classification</span>
                </span>
                <span class="wmsf-dot" :class="dotClass(2)" aria-hidden="true"></span>
            </button>
        </li>
    </ul>

    <section class="wmsf-pane" x-show="step === 1" x-cloak role="tabpanel">
        <div class="wmsf-pane-head">
            <div>
                <p class="wmsf-pane-eyebrow">— Section 01</p>
                <h2>Identity</h2>
                <p class="wmsf-pane-desc">Code is permanent — to use a different SKU, create a new product.</p>
            </div>
        </div>

        <div class="wmsf-grid wmsf-grid-2">
            <div class="wmsf-field">
                <label class="wmsf-field-label">Code</label>
                <input class="wmsf-input" value="@Model.Code" readonly disabled />
                <span class="wmsf-helper">Code cannot be changed.</span>
            </div>

            <div class="wmsf-field">
                <label asp-for="Name" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.Name) <span class="req">*</span>
                </label>
                <input asp-for="Name" class="wmsf-input" @@input="onTouch('Name')" />
                <span asp-validation-for="Name" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field col-span-2">
                <label asp-for="Brand" class="wmsf-field-label">@Html.DisplayNameFor(m => m.Brand)</label>
                <input asp-for="Brand" class="wmsf-input" @@input="onTouch('Brand')" />
                <span asp-validation-for="Brand" class="wmsf-error"></span>
            </div>
        </div>
    </section>

    <section class="wmsf-pane" x-show="step === 2" x-cloak role="tabpanel">
        <div class="wmsf-pane-head">
            <div>
                <p class="wmsf-pane-eyebrow">— Section 02</p>
                <h2>Classification</h2>
                <p class="wmsf-pane-desc">Adjust category, unit, tracking, and lifecycle.</p>
            </div>
        </div>

        <div class="wmsf-grid wmsf-grid-2">
            <div class="wmsf-field">
                <label asp-for="CategoryId" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.CategoryId) <span class="req">*</span>
                </label>
                <select asp-for="CategoryId" class="wmsf-select" @@change="onTouch('CategoryId')">
                    <option value="">— Select category —</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@c.Code · @c.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="BaseUomId" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.BaseUomId) <span class="req">*</span>
                </label>
                <select asp-for="BaseUomId" class="wmsf-select" @@change="onTouch('BaseUomId')">
                    <option value="">— Select unit —</option>
                    @foreach (var u in Model.BaseUoms)
                    {
                        <option value="@u.Id">@u.Code · @u.Name</option>
                    }
                </select>
                <span asp-validation-for="BaseUomId" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="TrackingMethod" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.TrackingMethod) <span class="req">*</span>
                </label>
                <select asp-for="TrackingMethod" class="wmsf-select" @@change="onTouch('TrackingMethod')">
                    @foreach (var tm in WMS.Web.Models.Master.ProductEditViewModel.AllTrackingMethods)
                    {
                        <option value="@tm">@tm</option>
                    }
                </select>
                <span asp-validation-for="TrackingMethod" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="Status" class="wmsf-field-label">
                    @Html.DisplayNameFor(m => m.Status) <span class="req">*</span>
                </label>
                <select asp-for="Status" class="wmsf-select" @@change="onTouch('Status')">
                    @foreach (var s in WMS.Web.Models.Master.ProductEditViewModel.AllStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <span asp-validation-for="Status" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label asp-for="VelocityClass" class="wmsf-field-label">@Html.DisplayNameFor(m => m.VelocityClass)</label>
                <input asp-for="VelocityClass" class="wmsf-input" @@input="onTouch('VelocityClass')" />
                <span asp-validation-for="VelocityClass" class="wmsf-error"></span>
            </div>

            <div class="wmsf-field">
                <label class="wmsf-field-label">Catch-weight</label>
                <label class="wmsf-check-item">
                    <input asp-for="UseCatchWeight" type="checkbox" />
                    Weigh at pick
                </label>
            </div>
        </div>
    </section>

    <div class="wmsf-actions">
        <a asp-controller="Products" asp-action="Detail" asp-route-sku="@Model.Code" class="wmsf-btn">
            <i class="ti ti-x" aria-hidden="true"></i> Cancel
        </a>
        <span class="wmsf-actions-info">
            <span x-show="!Object.keys(touched).length">No unsaved changes</span>
            <span x-show="Object.keys(touched).length" style="color: var(--wmsf-warning-fg);">
                Unsaved changes
            </span>
        </span>
        <button type="submit" class="wmsf-btn wmsf-btn-primary">
            <i class="ti ti-check" aria-hidden="true"></i> Save changes
        </button>
    </div>
</form>

<style>[x-cloak] { display: none !important; }</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/wmsf-form-state.js" asp-append-version="true"></script>
}
