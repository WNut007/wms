@model WMS.Web.ViewModels.SuperAdmin.TenantListViewModel
@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Tenants";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h1 class="sa-title" style="margin: 0;">Tenants</h1>
    <a href="/SuperAdmin/Tenants/Create" class="sa-btn">
        <i class="ti ti-plus"></i> Provision new tenant
    </a>
</div>

@if (TempData["SuperAdminMessage"] is string okMsg)
{
    <div class="sa-banner-ok">@okMsg</div>
}
@if (TempData["SuperAdminError"] is string errMsg)
{
    <div class="sa-banner-err">@errMsg</div>
}

<div style="display: flex; gap: 8px; margin-bottom: 16px;">
    <a href="/SuperAdmin/Tenants" class="sa-btn @(string.IsNullOrEmpty(Model.StatusFilter) ? "" : "sa-btn-secondary")" style="font-size: 12px; padding: 6px 12px;">
        All (@(Model.CountActive + Model.CountSuspended + Model.CountInactive))
    </a>
    <a href="/SuperAdmin/Tenants?status=Active" class="sa-btn @(Model.StatusFilter == "Active" ? "" : "sa-btn-secondary")" style="font-size: 12px; padding: 6px 12px;">
        Active (@Model.CountActive)
    </a>
    <a href="/SuperAdmin/Tenants?status=Suspended" class="sa-btn @(Model.StatusFilter == "Suspended" ? "" : "sa-btn-secondary")" style="font-size: 12px; padding: 6px 12px;">
        Suspended (@Model.CountSuspended)
    </a>
    <a href="/SuperAdmin/Tenants?status=Inactive" class="sa-btn @(Model.StatusFilter == "Inactive" ? "" : "sa-btn-secondary")" style="font-size: 12px; padding: 6px 12px;">
        Inactive (@Model.CountInactive)
    </a>
</div>

<div class="sa-card" style="padding: 0;">
    <table class="sa-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Database</th>
                <th>Status</th>
                <th>Users</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="6" style="text-align: center; padding: 32px; color: var(--sa-text-secondary);">No tenants found.</td></tr>
            }
            @foreach (var t in Model.Rows)
            {
                <tr onclick="window.location='/SuperAdmin/Tenants/@t.Id'">
                    <td><span class="sa-mono">@t.Code</span></td>
                    <td>@t.Name</td>
                    <td><span class="sa-mono">@t.DatabaseName</span></td>
                    <td>
                        <span class="sa-badge @(t.Status switch {
                            "Active" => "sa-badge-active",
                            "Suspended" => "sa-badge-suspend",
                            _ => "sa-badge-inactive"
                        })">@t.Status</span>
                    </td>
                    <td>@t.UserCount</td>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
